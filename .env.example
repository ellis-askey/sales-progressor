# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/sales_progressor"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Sprint 7: AI message generation
# Get your key from https://console.anthropic.com
# Model used: claude-haiku-4-5-20251001 (fast + cheap)
ANTHROPIC_API_KEY="sk-ant-..."

# Rate limiting (Upstash Redis) — required for auth, AI, and email rate limits
# Create a free Redis database at https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# NOTE: DEV_AUTH_BYPASS was listed here previously but is not referenced anywhere
# in the codebase. It has been removed.

# Google OAuth (create at console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft Azure AD OAuth — used for SIGNING INTO the app (NextAuth login only)
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
# Use specific tenant ID to restrict to one org, or "common" for any Microsoft account
AZURE_AD_TENANT_ID="common"

# Microsoft Outlook integration — used for CONNECTING A MAILBOX (Microsoft Graph).
# This is a SEPARATE Entra app registration from the login one above, with
# delegated Graph permissions: User.Read, Mail.Read, Mail.Send, offline_access.
# Redirect URI must exactly match the one registered in Entra.
# Tokens are encrypted at rest reusing ADMIN_TOTP_ENCRYPTION_KEY (below) — no new secret needed.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""
MICROSOFT_REDIRECT_URI="https://thesalesprogressor.co.uk/api/integrations/outlook/callback"

# PostHog analytics
# Client-side (browser): get from PostHog project settings → Project API key
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
# Server-side (Node.js): same value as above — needed for server-side event tracking
POSTHOG_API_KEY="phc_..."
# Override host if not on PostHog EU cloud (default: https://eu.i.posthog.com)
# POSTHOG_HOST="https://eu.i.posthog.com"

# Command Centre (superadmin) — Phase 2
# Generate ADMIN_TOTP_ENCRYPTION_KEY: openssl rand -hex 32
ADMIN_TOTP_ENCRYPTION_KEY="64-hex-chars-here"
# Generate ADMIN_AUDIT_HMAC_KEY: openssl rand -hex 32
ADMIN_AUDIT_HMAC_KEY="64-hex-chars-here"
# Comma-separated IPs/CIDRs; leave empty to allow all
ADMIN_IP_ALLOWLIST=""
