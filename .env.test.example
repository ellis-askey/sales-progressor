# .env.test.example — Playwright test credentials
# Copy this file to .env.test and fill in real values.
# .env.test is gitignored — never commit it.

# Default password shared by most test accounts
TEST_PASSWORD=

# Superadmin account (WS2-6) — skip test if not set
TEST_SUPERADMIN_EMAIL=
TEST_SUPERADMIN_PASSWORD=

# Director account (PD-8, PD-9, WS2-5)
TEST_DIRECTOR_EMAIL=taylor@akeman-residential.co.uk
TEST_DIRECTOR_PASSWORD=

# Negotiator account (PD-8, PD-9, WS2-5b) — skip tests if not set
TEST_NEGOTIATOR_EMAIL=
TEST_NEGOTIATOR_PASSWORD=

# Zero-file sales_progressor (PD-5, PD-6)
# Seeded via: npx ts-node --compiler-options '{"module":"CommonJS"}' scripts/seed-test-accounts.ts
TEST_PROGRESSOR_ZERO_EMAIL=ellis+zero@thesalesprogressor.co.uk
TEST_PROGRESSOR_ZERO_PASSWORD=password
