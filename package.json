{
  "name": "sales-progressor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/vercel-db-deploy.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:status:staging": "dotenv -e .env --override -- prisma migrate status",
    "db:migrate:staging": "dotenv -e .env --override -- prisma migrate deploy",
    "db:migrate:status:prod": "dotenv -e .env.production --override -- prisma migrate status",
    "db:migrate:prod": "node scripts/migrate-prod.mjs",
    "db:push": "prisma db push",
    "db:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "db:studio": "prisma studio",
    "demo:seed":  "dotenv -e .env --override -- ts-node --transpile-only --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\",\\\"esModuleInterop\\\":true,\\\"baseUrl\\\":\\\".\\\",\\\"paths\\\":{\\\"@/*\\\":[\\\"./*\\\"]}}\" -r tsconfig-paths/register scripts/seed-demo.ts",
    "demo:reset": "dotenv -e .env --override -- ts-node --transpile-only --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\",\\\"esModuleInterop\\\":true,\\\"baseUrl\\\":\\\".\\\",\\\"paths\\\":{\\\"@/*\\\":[\\\"./*\\\"]}}\" -r tsconfig-paths/register scripts/reset-demo.ts",
    "demo:verify": "dotenv -e .env --override -- ts-node --transpile-only --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\",\\\"esModuleInterop\\\":true,\\\"baseUrl\\\":\\\".\\\",\\\"paths\\\":{\\\"@/*\\\":[\\\"./*\\\"]}}\" -r tsconfig-paths/register scripts/demo-verify.ts",
    "test": "jest",
    "test:consent": "jest __tests__/analytics/posthog-consent.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.0",
    "@auth/prisma-adapter": "^2.4.1",
    "@formkit/auto-animate": "^0.9.0",
    "@lottiefiles/react-lottie-player": "^3.6.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^5.22.0",
    "@sendgrid/client": "^8.1.6",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/nextjs": "^10.53.1",
    "@stripe/react-stripe-js": "^6.4.0",
    "@stripe/stripe-js": "^9.6.0",
    "@supabase/supabase-js": "^2.104.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "autoprefixer": "^10.5.0",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "fuse.js": "^7.3.0",
    "lucide-react": "^1.8.0",
    "next": "^16.2.4",
    "next-auth": "^4.24.10",
    "next-mdx-remote": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.59.1",
    "posthog-js": "^1.372.6",
    "posthog-node": "^5.33.3",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "react-number-format": "^5.4.5",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "replicate": "^1.4.0",
    "stripe": "^22.1.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8",
    "eslint-config-next": "15.0.3",
    "eslint-plugin-local-rules": "^3.0.2",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "pg": "^8.21.0",
    "postcss": "^8.5.10",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "node_modules/.bin/ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
