// Package D: idempotency record for the "new outsourced file" admin email.
// One row per transaction, ever. If a row exists the notification has fired.

model OutsourcedAssignmentNotification {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  transactionId  String   @unique
  sentAt         DateTime
  recipientEmail String

  transaction PropertyTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([sentAt])
}

// â”€â”€â”€ NegotiatorInvitation â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Created when a director adds a negotiator. The negotiator receives an email
// with a link to set their own password. The User row is created immediately
// (password: null) so the negotiator appears in the team list as "pending".

model NegotiatorInvitation {
  id               String    @id @default(cuid())
  agencyId         String
  invitedByUserId  String
  negotiatorName   String
  negotiatorEmail  String
  token            String    @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  agency     Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  invitedBy  User   @relation("NegotiatorInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy User?  @relation("NegotiatorInvitationsAccepted", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([agencyId])
  @@index([token])
  @@index([negotiatorEmail])
}

// ── FileTimeSession ──────────────────────────────────────────────────────────
// Tracks engaged (tab visible + window focused) time per user per transaction.
// Sessions < 10s engaged are discarded on close. Stale open sessions (no
// heartbeat for 5min) are auto-closed by /api/cron/file-time-close.

model FileTimeSession {
  id                  String    @id @default(cuid())
  transactionId       String
  userId              String
  agencyId            String
  startedAt           DateTime  @default(now())
  endedAt             DateTime?
  lastActivityAt      DateTime  @default(now())
  engagementIntervals Json      @default("[]")
  totalEngagedSeconds Int?
  userAgent           String?
  closedReason        String?

  transaction PropertyTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id])
  agency      Agency              @relation(fields: [agencyId], references: [id])

  @@index([transactionId, userId])
  @@index([userId, startedAt])
  @@index([agencyId, startedAt])
}

// ── SystemNotification ───────────────────────────────────────────────────────
// One-shot notification flags. Each `key` is a unique identifier for a single
// platform-level event we never want to fire twice (e.g. "medians_ready" —
// the first time we have enough completion data to swap the hardcoded
// MILESTONE_DURATION_MEDIANS for learned values). Cron jobs check for the
// row's existence before doing any expensive computation, and write the row
// after enqueueing the notification. Resetting requires deleting the row
// manually (intended — these are platform-lifetime events).

model SystemNotification {
  id        String   @id @default(cuid())
  key       String   @unique
  firedAt   DateTime
  createdAt DateTime @default(now())
}

// ── Notification ─────────────────────────────────────────────────────────────
// Per-user, per-event in-app notification queue. DISTINCT from
// SystemNotification (which is a one-shot platform flag with no userId).
// Used by SPBell on the internal dashboard to surface confirmation events on
// files assigned to the current Sales Progressor. `payload` is type-specific
// JSON; `readAt` is set when the user clicks the bell.
//
// Types currently in use:
//   - "portal_milestone_confirm"            (buyer/seller confirmed via portal)
//   - "agent_outsourced_milestone_confirm"  (agent confirmed step on outsourced file)

model Notification {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  transactionId String?
  transaction   PropertyTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  payload       Json
  createdAt     DateTime             @default(now())
  readAt        DateTime?

  @@index([userId, readAt, createdAt])
}

// ── ClientChaseState ──────────────────────────────────────────────────────────
// Per-(transaction, contact, milestone) state for the automated client-chase
// pipeline (Sub-arc B). The cron reads this table to decide who to chase,
// who to escalate, and who to hand back to the agent via the fail-soft
// helper. NOT touched by Sub-arc A (table created in B2; no callers until B7).
//
// Lifecycle:
//   1. Cron finds (transaction, contact, milestone) tuples eligible for the
//      first chase → creates a row with status="active", chaseCount=0,
//      firstChasedAt=null. (Created when the first chase is about to send;
//      not pre-created for every eligible row.)
//   2. Each chase send: chaseCount++, lastChasedAt=now. firstChasedAt set on
//      the first send.
//   3. Each client engagement (portal visit / note / date-set): lastEngagedAt
//      = now. The 14-day silence window restarts from this point.
//   4. Milestone confirmed (by anyone) → status="completed". Row stays for
//      audit; not deleted.
//   5. Escalation ceiling hit (chaseCount >= 2 OR (now - firstChasedAt) >=
//      14d AND lastEngagedAt < firstChasedAt) → status="escalated"; the
//      A4 fail-soft helper creates an agent ChaseTask with the right kind.
//   6. Contact unsubscribes → status="opted_out"; A4 fail-soft fires with
//      kind="client_opted_out".
//
// Status values (free-form String for forward-compat):
//   - "active"     — eligible for chase
//   - "completed"  — milestone confirmed; row inert (kept for audit)
//   - "escalated"  — ceiling hit; agent ChaseTask exists
//   - "opted_out"  — contact unsubscribed; agent ChaseTask exists

model ClientChaseState {
  id            String    @id @default(cuid())
  transactionId String
  contactId     String
  milestoneCode String
  chaseCount    Int       @default(0)
  firstChasedAt DateTime?
  lastChasedAt  DateTime?
  lastEngagedAt DateTime?
  status        String    @default("active")
  // Human-readable reason for the current status. Set when the row leaves
  // "active" (escalation reason: chase_count / silence_14d; cancellation
  // reason: milestone_reversed / milestone_completed / relist / hold /
  // portal_confirmed). Null on active rows and on rows whose transition
  // pre-dates this field. Read by the file's chase-history panel to
  // explain "why did this stop" without the reader inferring from silence.
  statusReason  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Phase 0 shadow attribution. Stamped when contact.roleType =
  // 'purchaser'. Not read anywhere yet.
  buyerRoundId String?
  buyerRound   BuyerRound? @relation(fields: [buyerRoundId], references: [id], onDelete: SetNull)

  transaction PropertyTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  contact     Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([transactionId, contactId, milestoneCode])
  @@index([status, lastChasedAt])
  @@index([contactId, status])
  @@index([buyerRoundId])
}

// ─── Payments ─────────────────────────────────────────────────────────────
// Scaffolding-only in this migration: tables present, no behaviour wired yet.
// See docs/active/payments-build-plan.md for the staged rollout.

enum InvoiceStatus {
  building // current month, accruing
  issued // month closed, Stripe invoice created
  paid // Stripe webhook confirmed payment
  failed // Stripe webhook confirmed failure
  void // manually voided
}

model Invoice {
  id              String        @id @default(cuid())
  agencyId        String
  agency          Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  // First-of-month timestamp UTC marking the billing period.
  // IMPORTANT: the rule for which billing month an exchange falls into is
  // computed in Europe/London (so an exchange at 00:30 on the 1st London
  // time doesn't land on last month's invoice). Storage stays UTC; the
  // boundary computation lives in lib/billing/period.ts (PR 5).
  monthStart      DateTime
  status          InvoiceStatus @default(building)
  issuedAt        DateTime?
  paidAt          DateTime?
  stripeInvoiceId String?
  lines           InvoiceLine[]
  appliedCredits  CreditNote[]  @relation("InvoiceCreditApplications")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([agencyId, monthStart])
  @@index([status])
}

enum InvoiceLineKind {
  in_house_fee
  outsourced_fee
  credit_applied
}

model InvoiceLine {
  id            String               @id @default(cuid())
  invoiceId     String
  invoice       Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  transactionId String?
  transaction   PropertyTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  kind          InvoiceLineKind
  description   String
  // amountPence is ex-VAT when the agency is VAT-registered at issuance time;
  // inclusive otherwise. Rendering reads agency.vatRegisteredAt to decide.
  amountPence   Int
  vatPence      Int                  @default(0)
  totalPence    Int // amountPence + vatPence
  createdAt     DateTime             @default(now())

  @@index([invoiceId])
  @@index([transactionId])
}

// Pricing disclosure text shown to the director at first card capture.
// Ships EMPTY in PR 1 — its first row is inserted only when the actual
// disclosure copy is designed (separate task before PR 6 ships).
// Never seed with placeholder text — see payments-build-plan.md PR 6 flag.
model TermsVersion {
  id               String                   @id @default(cuid())
  versionTag       String                   @unique // e.g. "2026-05-payments-v1"
  // JSONB array of { heading: string, body: string }. Structured so the
  // renderer maps over sections cleanly + future versions can change wording
  // without breaking the parser. See lib/billing/terms-sections.ts for the
  // TypeScript type.
  bodySections     Json
  effectiveFrom    DateTime
  createdAt        DateTime                 @default(now())
  acknowledgements PricingAcknowledgement[]
}

// One row per director acknowledgement of the pricing disclosure.
// The acknowledgedByName + acknowledgedByEmail strings ARE the audit record;
// the FK to User is a convenience link that nulls on user delete (GDPR-safe).
model PricingAcknowledgement {
  id                   String       @id @default(cuid())
  agencyId             String
  agency               Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  acknowledgedByUserId String?
  acknowledgedBy       User?        @relation(fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)
  acknowledgedByName   String // denormalised at acknowledgement — the audit record
  acknowledgedByEmail  String // denormalised at acknowledgement — the audit record
  termsVersionId       String
  termsVersion         TermsVersion @relation(fields: [termsVersionId], references: [id])
  acknowledgedAt       DateTime     @default(now())

  @@index([agencyId])
}

// Credit against a future invoice. Written when an exchange that was already
// invoiced gets reversed via executeUndoMilestone (PR 4). Model is credit-only:
// no cash refunds (per locked model in payments-build-plan.md).
model CreditNote {
  id                 String               @id @default(cuid())
  agencyId           String
  agency             Agency               @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  transactionId      String?
  transaction        PropertyTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  amountPence        Int
  reason             String // e.g. "Exchange reversed post-invoice — VM19 undone on 2026-06-12"
  appliedToInvoiceId String?
  appliedToInvoice   Invoice?             @relation("InvoiceCreditApplications", fields: [appliedToInvoiceId], references: [id])
  appliedAt          DateTime?
  createdAt          DateTime             @default(now())

  @@index([agencyId])
  @@index([appliedToInvoiceId])
}
