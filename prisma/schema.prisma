// Sales Progressor - Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Agency {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modeProfile           AgencyModeProfile @default(self_progressed)
  modeProfileComputedAt DateTime?

  isInternal Boolean @default(false)

  // Master toggle for automated client-facing chase emails on this agency's
  // files. When false, the client-chase cron skips digest enqueue for any
  // file owned by this agency. The chase clock keeps running and the agent
  // reminder engine sets a "client_emails_paused" fallback chip on the
  // existing ChaseTask so the work surfaces as a manual task. Directors
  // toggle via /agent/settings/automation.
  chaseEmailsEnabled Boolean @default(true)

  // Verified sender address for outbound surveyor quote requests on this
  // agency's files (e.g. ellis@akeman-residential.co.uk). Null → the quote is
  // sent from the Sales Progressor fallback (ellis@thesalesprogressor.co.uk).
  // Must be a verified SendGrid sender for the agency's domain.
  quoteSenderEmail String?

  // Signup attribution
  signupSource      String?
  signupMedium      String?
  signupCampaign    String?
  signupReferrer    String?
  signupLandingPage String?
  signupAt          DateTime?

  // Payments — frozen trial flag anchor.
  // Set on this agency's first-ever PropertyTransaction create. NEVER updated thereafter.
  // PropertyTransaction.freeOnExchange is computed at create time from
  // (now - firstSubmissionAt <= 7 days) and persisted on the row; this field is only
  // re-read on subsequent creates to evaluate the trial window for the next file.
  firstSubmissionAt DateTime?

  // VAT scaffolding — present day one so the future flip is config, not migration.
  // While vatRegisteredAt is null, invoice rendering shows the inclusive total only.
  // When set, rendering splits the line into ex-VAT amount + VAT line at vatRateBps.
  vatRegisteredAt DateTime?
  vatRateBps      Int? // basis points: 2000 = 20%

  // Stripe + payment lifecycle.
  stripeCustomerId         String?
  paymentFailedAt          DateTime? // Set by Stripe webhook on invoice.payment_failed
  newFileCreationBlockedAt DateTime? // Set by check-failed-payments cron ~7d after paymentFailedAt

  // Per-agency fee tier — overrides the £250/£300/£350 outsourced sliding scale
  // when set to "legacy". calculateOurFee checks this first; if "standard" (the
  // default) the existing per-SP sliding scale applies. Self-managed (£59) is
  // never affected by this override. Set via /agent/admin by ellis.
  feeTier                  ClientType @default(standard)
  legacyOutsourcedFeePence Int? // Required when feeTier=legacy, null otherwise

  users                   User[]
  transactions            PropertyTransaction[]
  manualTasks             ManualTask[]
  chains                  PropertyChain[]
  verifiedDomains         VerifiedDomain[]
  recommendedSolicitors   AgencyRecommendedSolicitor[]
  preferredBroker         AgencyPreferredBroker?
  feedbackSubmissions     FeedbackSubmission[]
  negotiatorInvitations   NegotiatorInvitation[]
  directorInvitations     DirectorInvitation[]
  fileTimeSessions        FileTimeSession[]
  invoices                Invoice[]
  pricingAcknowledgements PricingAcknowledgement[]
  creditNotes             CreditNote[]
  agentEmailLogs          AgentEmailLog[]

  @@index([modeProfile])
  @@index([signupAt])
}

enum AgencyModeProfile {
  self_progressed
  progressor_managed
  mixed
}

model User {
  id                  String     @id @default(cuid())
  name                String
  email               String     @unique
  password            String?
  totpSecret          String?
  totpActivatedAt     DateTime?
  role                UserRole   @default(viewer)
  agencyId            String?
  firmName            String?
  progressorId        String?
  clientType          ClientType @default(standard)
  legacyFee           Int?
  phone               String?
  canViewAllFiles     Boolean    @default(false)
  hasSeenAgentWelcome Boolean    @default(false)
  isInternal          Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  agency               Agency?               @relation(fields: [agencyId], references: [id])
  progressor           User?                 @relation("ProgressorAgents", fields: [progressorId], references: [id])
  managedAgents        User[]                @relation("ProgressorAgents")
  assignedTransactions PropertyTransaction[] @relation("AssignedUser")
  agentFiles           PropertyTransaction[] @relation("AgentFiles")
  pausedTransactions   PropertyTransaction[] @relation("PausedTransactions")
  milestoneCompletions MilestoneCompletion[] @relation("CompletedBy")
  markedNotRequired    MilestoneCompletion[] @relation("NotRequiredBy")
  chaseTasks           ChaseTask[]
  escalatedChaseTasks  ChaseTask[]           @relation("ChaseTaskEscalatedBy")
  communications       OutboundMessage[]     @relation("CommCreatedBy")
  sentPortalMessages   PortalMessage[]       @relation("PortalMessagesSentBy")
  acknowledgedRelists  BuyerRound[]          @relation("BuyerRoundRelistAck")

  retentionEmailOptOut Boolean   @default(false)
  emailUnsubscribedAt  DateTime?

  // Set by sendWelcomeEmailIfNotSent when the user receives the instant
  // welcome (password signup completion + OAuth signup completion). Used as
  // the dedup mechanism: the helper atomically transitions NULL -> timestamp
  // and short-circuits if already stamped. The day-1 retention cron skips
  // any user where this is non-null, preventing the duplicate-send window
  // where someone signed up + didn't add a sale by 09:00 UTC the next day.
  welcomeEmailSentAt DateTime?

  // Portal-invite prompt skip tracking. Surfaced to internal staff on the
  // Command Centre overview ("how many agents are opting out of the portal
  // at sale-creation time"). Incremented atomically by /api/agent/portal-invite-skip
  // when the agent clicks "I won't be using the portal" on the new-sale form.
  portalInviteSkipCount  Int       @default(0)
  lastPortalInviteSkipAt DateTime?

  // In-app notification: negotiator sees this when their invited director accepts
  directorJoinedNotificationName String?
  directorJoinedNotificationAt   DateTime?

  // In-app notification: originator sees this when a chain invite they sent is declined
  chainDeclineNotificationAddress String?
  chainDeclineNotificationAt      DateTime?

  // Per-agent opt-in for the chain drawer's live activity feed (#14). Default
  // OFF: the feed only renders once the agent turns it on, and it stays on
  // across every chain they view. Toggled via POST /api/chains/activity.
  chainActivityOptIn Boolean @default(false)

  emailVerified          DateTime?
  image                  String?
  // Focal point (percent) for cropping `image` into circular avatars, so a
  // portrait headshot can be nudged to keep the face centred. Applied as
  // object-position by UserAvatar. 50/50 = dead centre (the default, so
  // existing photos are unaffected). Set from Command Centre → agent drill-down.
  imageFocusX            Int       @default(50)
  imageFocusY            Int       @default(50)
  accounts               Account[]
  sessions               Session[]
  transactionNotes       TransactionNote[]
  createdManualTasks     ManualTask[]            @relation("ManualTaskCreator")
  assignedManualTasks    ManualTask[]            @relation("ManualTaskAssignee")
  createdDomains         VerifiedDomain[]        @relation("DomainCreatedBy")
  verifiedEmails         UserVerifiedEmail[]
  feedbackSubmissions    FeedbackSubmission[]
  agentPushSubscriptions AgentPushSubscription[]
  retentionEmailLogs     RetentionEmailLog[]
  commandPreferences     Json?
  agentPreferences       Json?
  createdChains          PropertyChain[]         @relation("ChainCreatedBy")
  createdChainLinks      ChainLink[]             @relation("ChainLinkCreatedBy")
  claimedChainLinks      ChainLink[]             @relation("ChainLinkClaimedBy")
  lastInvitedChainLinks  ChainLink[]             @relation("ChainLinkLastInviteSentBy")

  negotiatorInvitationsSent     NegotiatorInvitation[]   @relation("NegotiatorInvitationsSent")
  negotiatorInvitationsAccepted NegotiatorInvitation[]   @relation("NegotiatorInvitationsAccepted")
  invitationsSent               DirectorInvitation[]     @relation("InvitationsSent")
  invitationsAccepted           DirectorInvitation[]     @relation("InvitationsAccepted")
  fileTimeSessions              FileTimeSession[]
  notifications                 Notification[]
  outboundEmailQueueAsRecipient OutboundEmailQueue[]     @relation("OutboundEmailQueueRecipientUser")
  editedEmailQueueRows          OutboundEmailQueue[]     @relation("EmailQueueEditedBy")
  chainNotifications            ChainNotificationQueue[]
  holdsStarted                  TransactionHoldPeriod[]  @relation("HoldStartedBy")
  holdsEnded                    TransactionHoldPeriod[]  @relation("HoldEndedBy")
  pricingAcknowledgements       PricingAcknowledgement[]
  quoteRequestsStatusChanged    QuoteRequest[]           @relation("QuoteRequestStatusChangedBy")
  outlookConnections            OutlookConnection[]
  agentEmailLogs                AgentEmailLog[]
  whatsAppConnections           WhatsAppConnection[]
}

model AgentPushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  // Captured from req.headers.get("user-agent") at subscribe time. Drives
  // the "Chrome on Mac" labels in the settings devices list. Nullable —
  // existing rows fall back to a generic "Subscribed device" label.
  userAgent  String?
  // Updated on every successful pushToUser send to this subscription so
  // users can spot dead devices in the settings list. Nullable — rows
  // that have never received a push fall back to the createdAt date.
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  superadmin
  admin
  sales_progressor
  director
  negotiator
  viewer
}

enum ClientType {
  legacy
  standard
}

enum ServiceType {
  self_managed
  outsourced
}

enum ProgressedBy {
  progressor
  agent
}

model PropertyTransaction {
  id                          String            @id @default(cuid())
  propertyAddress             String
  status                      TransactionStatus @default(active)
  agencyId                    String
  assignedUserId              String?
  assignedAt                  DateTime?
  agentUserId                 String?
  progressedBy                ProgressedBy      @default(progressor)
  serviceType                 ServiceType       @default(self_managed)
  expectedExchangeDate        DateTime?
  purchasePrice               Int?
  // Buyer-entered figures from the portal "Your costs" card (in pence), used to
  // estimate the completion balance still to fund. Purchaser-supplied.
  clientDepositGBP            Int?
  clientMortgageGBP           Int?
  // Buyer-confirmed stamp-duty circumstances (drive the SDLT estimate) and a
  // flag for when they've told us the completion funds are on their way.
  // clientAdditionalProperty doubles as the "has confirmed their situation"
  // signal: null = not answered yet (SDLT shown faded), true/false = answered.
  clientFirstTimeBuyer        Boolean?
  clientAdditionalProperty    Boolean?
  clientCompletionFundsSent   Boolean?
  // Any funds the buyer has already sent beyond the exchange deposit (pence),
  // so they don't have to inflate the deposit to make the balance match.
  clientOtherFundsSentGBP     Int?
  tenure                      Tenure?
  purchaseType                PurchaseType?
  isShareOfFreehold           Boolean           @default(false)
  // Free-text surveyor name when the buyer booked a firm OUTSIDE our network
  // (captured on the survey-booked step). Title-cased on save. Null when they
  // booked one of our quoted firms (that name comes from the QuoteRequest) or
  // no surveyor is recorded.
  bookedSurveyorName          String?
  twelveWeekTarget            DateTime?
  predictedExchangeDate       DateTime?
  overridePredictedDate       DateTime?
  completionDate              DateTime?
  agentFeeAmount              Int?
  agentFeePercent             Decimal?
  agentFeeIsVatInclusive      Boolean?
  notes                       String?
  fallThroughReason           String?
  // Structured withdrawal classification — set at withdraw time alongside
  // the free-text fallThroughReason. Drives chain cascade direction in
  // cascadeChainWithdrawal. Null on files that have never been withdrawn.
  withdrawalReason            WithdrawalReason?
  // Closed-loop chain arc (2026-06-05): set true at relist when the agent
  // selected "Don't know yet" on the new buyer's onward-sale step. The hub
  // surfaces a "complete chain setup" prompt for the file until the agent
  // resolves the onward chain (or confirms there is none). Cleared back to
  // false when the chain step is completed via the prompt.
  chainSetupPending           Boolean           @default(false)
  referredFirmId              String?
  referralFee                 Int?
  referralFeeReceived         Boolean           @default(false)
  vendorSolicitorFirmId       String?
  vendorSolicitorContactId    String?
  purchaserSolicitorFirmId    String?
  purchaserSolicitorContactId String?
  brokerFirmId                String?
  brokerContactId             String?
  brokerReferralFee           Int?
  brokerReferralFeeReceived   Boolean           @default(false)
  purchaserBrokerReferral     Boolean           @default(false)

  // True when this file was added via the admin Migrate Sale page rather
  // than the standard create flow. Used to EXCLUDE backdated/historical
  // files from milestone-velocity analytics — their completedAt timestamps
  // are user-supplied estimates, not real-time signals, so averaging them
  // against organic files pollutes "time between milestone X and Y"
  // statistics. Set true by the migration action; defaults false.
  isMigrated Boolean @default(false)

  lastActivityAt DateTime?

  // Agent-provided WhatsApp group invite URL for this file. Populated after
  // the agent creates a group manually in WhatsApp and pastes the invite
  // link (e.g. https://chat.whatsapp.com/XXXXXX). When set, the agent can
  // one-click a personalised "join the group" WhatsApp message to each
  // client contact. Not surfaced on the client portal — invites go via
  // WhatsApp, not the portal.
  whatsappGroupInviteUrl String?

  // Optional property photo the agent uploads. photoStoragePath is relative
  // to the transaction-documents bucket (e.g. property-photos/{txId}.jpg);
  // photoUploadedAt supports cache-busting the signed URL. Rendered as a
  // hero image on the client portal; absent = no image rendered (no
  // dashed placeholder, no broken state). Single photo per file — re-uploads
  // overwrite.
  photoStoragePath String?
  photoUploadedAt  DateTime?

  // Founder dismissed the "no photo" upkeep reminder for this file (Command
  // Centre → Files). Set = drop off the "photos to add" list for good, even
  // though the file still has no photo (e.g. an old file that'll never get one).
  // Independent of photoStoragePath; uploading a photo naturally removes the
  // file from the list too.
  photoReminderDismissedAt DateTime?

  // Per-file pause toggle for automated client-facing chase emails. When
  // true, the client-chase cron skips digest enqueue for this file. The
  // chase clock keeps running underneath and escalation still fires —
  // pausing emails MUST NOT block the file from flagging to the team.
  // Toggled via the AutomationControls panel on the transaction-detail page.
  clientEmailsPaused Boolean   @default(false)
  pausedAt           DateTime? // When clientEmailsPaused was last set to true
  pausedById         String? // Which user toggled the pause on

  // Per-party email pause flags (solicitor-confirm feature). Replace the
  // single clientEmailsPaused with four independent toggles surfaced as a
  // menu on the file: seller / buyer / seller's firm / buyer's firm. The
  // solicitor "stop these emails for this matter" link flips the matching
  // *SolicitorEmailsPaused flag. clientEmailsPaused is retained until its
  // consumers migrate to vendorEmailsPaused + purchaserEmailsPaused (Stage 2c),
  // then dropped. See docs/active/solicitor-confirm/scope.md.
  vendorEmailsPaused             Boolean @default(false)
  purchaserEmailsPaused          Boolean @default(false)
  vendorSolicitorEmailsPaused    Boolean @default(false)
  purchaserSolicitorEmailsPaused Boolean @default(false)

  // Temporary internal-staff debug toggle. When true, the buyer/seller
  // portal confirmation email (sendAdminMilestoneNotificationToPortal)
  // is skipped on milestone confirms — all other side effects (chain
  // notifications, celebrations, reminder knock-on, DB writes) still
  // fire. SP/admin/superadmin only via the UI. Audit fields below let
  // us SQL-audit forgotten toggles. Default false = emails send.
  suppressPortalConfirmEmails        Boolean   @default(false)
  suppressPortalConfirmEmailsSetAt   DateTime?
  suppressPortalConfirmEmailsSetById String?

  // Per-transaction snapshot of chase rule values at creation time. JSON
  // map keyed by milestone code: { graceDays, repeatEveryDays,
  // useEventDate, anchorMilestoneCode, requiresExchangeReady }. The
  // client-chase cron reads from this snapshot rather than live
  // ReminderRule so Settings edits apply to NEW files only — in-flight
  // files keep their original schedule. Backfilled at migration time
  // for existing transactions. Defensive fallback: cron uses live
  // ReminderRule if snapshot is missing.
  chaseRuleSnapshot Json?

  // Payments — frozen trial flag.
  // Stamped at create time from (now - agency.firstSubmissionAt <= 7 days). NEVER recomputed.
  // Trial files exchange normally but do not generate a charge.
  freeOnExchange Boolean @default(false)

  // Set on VM19/PM26 completion for ALL files (trial and paying alike). Idempotent.
  // "Did this file exchange?" — answer.
  exchangedAt DateTime?

  // Exchange-day overlay — the agent flags "we're aiming to exchange TODAY".
  // Single-day and self-clearing: "active" is DERIVED, not stored — the UK
  // date of exchangeDayStartedAt must equal today, the file must not have
  // exchanged, and it must not have been cancelled since the last start. No
  // midnight cron; it simply stops being "today". Re-activating the next day
  // stamps a fresh startedAt. See docs/active/exchange-day-SPEC.md.
  exchangeDayStartedAt   DateTime?
  exchangeDayCancelledAt DateTime?
  // Per-slot send stamps for the exchange-day solicitor emails (08:45 / 12:30 /
  // 15:30 UK). "Sent for THIS activation" is derived as stamp >= startedAt, so
  // re-activating the next day naturally resets them with no cron/backfill.
  exchangeDayMorningEmailAt   DateTime?
  exchangeDayMiddayEmailAt     DateTime?
  exchangeDayAfternoonEmailAt  DateTime?
  // Per-slot send stamps for the exchange-day CLIENT emails (09:00 info + 11:00
  // authority nudge). Same "sent this activation" derivation (stamp >=
  // exchangeDayStartedAt) so re-activation resets them with no backfill.
  exchangeDayClientMorningEmailAt   DateTime?
  exchangeDayClientAuthorityEmailAt DateTime?

  // Set on VM19/PM26 completion ONLY when the exchange generates a charge.
  // Trial files leave this null. Guard against bilateral double-billing — checked
  // before write so the bilateral partner's auto-complete is a no-op.
  // "Did this file bill?" — answer.
  billedAtExchange DateTime?

  // Snapshot of purchasePrice at the moment of exchange. Billing reads from this
  // snapshot, not the live purchasePrice field — immune to later price edits.
  priceAtExchange Int? // pence

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency                           Agency                            @relation(fields: [agencyId], references: [id])
  assignedUser                     User?                             @relation("AssignedUser", fields: [assignedUserId], references: [id])
  agentUser                        User?                             @relation("AgentFiles", fields: [agentUserId], references: [id])
  pausedBy                         User?                             @relation("PausedTransactions", fields: [pausedById], references: [id])
  contacts                         Contact[]
  clientMoveInfos                  ClientMoveInfo[]
  vendorSolicitorFirm              SolicitorFirm?                    @relation("VendorSolicitorFirm", fields: [vendorSolicitorFirmId], references: [id])
  vendorSolicitorContact           SolicitorContact?                 @relation("VendorSolicitorContact", fields: [vendorSolicitorContactId], references: [id])
  purchaserSolicitorFirm           SolicitorFirm?                    @relation("PurchaserSolicitorFirm", fields: [purchaserSolicitorFirmId], references: [id])
  purchaserSolicitorContact        SolicitorContact?                 @relation("PurchaserSolicitorContact", fields: [purchaserSolicitorContactId], references: [id])
  referredFirm                     SolicitorFirm?                    @relation("ReferredFirm", fields: [referredFirmId], references: [id])
  brokerFirm                       BrokerFirm?                       @relation(fields: [brokerFirmId], references: [id])
  brokerContact                    BrokerContact?                    @relation(fields: [brokerContactId], references: [id])
  milestoneCompletions             MilestoneCompletion[]
  reminderLogs                     ReminderLog[]
  chaseTasks                       ChaseTask[]
  communications                   OutboundMessage[]
  priceHistory                     PriceHistory[]
  transactionNotes                 TransactionNote[]
  manualTasks                      ManualTask[]
  chainLinkId                      String?                           @unique
  chainLinks                       ChainLink[]                       @relation("ChainLinkToTransaction")
  chainLink                        ChainLink?                        @relation("TransactionActiveLink", fields: [chainLinkId], references: [id])
  portalMessages                   PortalMessage[]
  documents                        TransactionDocument[]
  flags                            TransactionFlag[]
  outsourcedAssignmentNotification OutsourcedAssignmentNotification?
  invoiceLines                     InvoiceLine[]
  creditNotes                      CreditNote[]
  fileTimeSessions                 FileTimeSession[]
  portalTimeSessions               PortalTimeSession[]
  notifications                    Notification[]
  clientChaseStates                ClientChaseState[]
  solicitorChaseStates             SolicitorChaseState[]
  holdPeriods                      TransactionHoldPeriod[]
  enquiryTracker                   EnquiryTracker?
  enquiryRaiseChase                EnquiryRaiseChase?
  onwardTracker                    OnwardTracker?
  followupTaps                     FollowupTap[]
  followupNudgesDisabled           Boolean                @default(false)
  chaseSends                       ChaseSend[]
  agentEmailLogs                   AgentEmailLog[]

  // Phase 0 of the relist feature — shadow only. No reads or writes
  // currently consume these fields; populated by backfill so the
  // foundation is in place for Phase 1 cutover. See
  // docs/active/relist-feature/ (Phase 0 plan).
  buyerRounds        BuyerRound[] @relation("TransactionBuyerRounds")
  activeBuyerRoundId String?      @unique
  activeBuyerRound   BuyerRound?  @relation("ActiveBuyerRound", fields: [activeBuyerRoundId], references: [id], onDelete: SetNull)

  quoteRequests QuoteRequest[]
  whatsAppGroupMappings WhatsAppGroupMapping[]

  @@index([serviceType, createdAt])
}

// Phase 0 of the relist feature — shadow foundation only. One BuyerRound
// per (transaction, attempt). Round 1 is backfilled onto every existing
// transaction. status, archivedAt, and the snapshot columns are NOT yet
// consumed by any read path; the live source of truth for buyer-side
// fields remains PropertyTransaction until Phase 1 cuts reads over.
//
// Round status semantics: tracks the buyer relationship, not the sale
// outcome. A completed transaction can have an active round. A withdrawn
// transaction is left with an active round in backfill — Phase 1
// reconciliation will set genuinely fallen-through rounds to withdrawn
// (carrying over PropertyTransaction.fallThroughReason) BEFORE round
// status drives any behaviour. Status must not go live unreconciled.
model BuyerRound {
  id            String              @id @default(cuid())
  transactionId String
  transaction   PropertyTransaction @relation("TransactionBuyerRounds", fields: [transactionId], references: [id], onDelete: Cascade)

  roundNumber       Int
  status            BuyerRoundStatus @default(active)
  fallThroughReason String?

  // Point-in-time snapshots of PropertyTransaction buyer-side fields.
  // Backfilled from the transaction at round creation. Will be
  // re-synced from PropertyTransaction at Phase 1 cutover rather than
  // trusted as-is.
  purchasePrice               Int?
  purchaserSolicitorFirmId    String?
  purchaserSolicitorContactId String?
  brokerFirmId                String?
  brokerContactId             String?

  // Audit JSON of vendor milestones (VM2, VM7, VM10–VM20) at the
  // moment of relist, before they get reset in place on the new round.
  // Written by the relist server action (Phase 1, commit 6) onto the
  // OUTGOING round before archive. Empty/null on the active round.
  // Shape: Array<{ code, state, completedAt, completedById, summaryText,
  // eventDate, reconciledAtExchange }>. Stored as JSONB so future
  // analytics can read it without a schema migration.
  vendorMilestoneSnapshot Json?

  // Closed-loop chain arc (2026-06-05): snapshot of the chain state at
  // the moment this round was archived (withdraw). Captures every claimed
  // link in the chain at that instant (their position, withdrawalStatus,
  // claiming agent, agency) AND every notification that fired during the
  // cascade (recipient, type, direction, response received if any).
  // Rendered by the ArchivedRoundDrawer's "Chain at withdrawal" section.
  // Shape: {
  //   chainId: string,
  //   ourPosition: number,
  //   withdrawalReason: WithdrawalReason,
  //   neighbours: Array<{ linkId, position, withdrawalStatus,
  //     claimedByUserId, agencyName, agentName, claimedTransactionId }>,
  //   notifications: Array<{ recipientLinkId, type, direction, response,
  //     respondedAt, sentAt }>,
  //   detachedSegment: { chainId, splitAt: ISO-date } | null
  // }
  // Null on the active round (only set at archive time).
  chainSnapshot Json?

  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  // Acknowledgement of the relist event that created THIS round. Set
  // when an authorised user clicks "Acknowledge" on the hub's "New
  // buyer added" card. Persisted on the round (not on the tx) because
  // a second relist creates a fresh unacknowledged state — each round
  // needs its own click. Round 1 is created at file-create time, not
  // via relist, so it's structurally unacknowledgeable (the card query
  // filters roundNumber > 1). Phase 1 commit 8b — hub card addition.
  relistAcknowledgedAt   DateTime?
  relistAcknowledgedById String?
  relistAcknowledgedBy   User?     @relation("BuyerRoundRelistAck", fields: [relistAcknowledgedById], references: [id])

  // Reverse relations — all nullable on the child side. No read path
  // consumes these in Phase 0.
  contacts             Contact[]
  milestoneCompletions MilestoneCompletion[]
  outboundMessages     OutboundMessage[]
  portalMessages       PortalMessage[]
  documents            TransactionDocument[]
  reminderLogs         ReminderLog[]
  chaseTasks           ChaseTask[]
  priceHistory         PriceHistory[]
  clientChaseStates    ClientChaseState[]

  // Inverse of PropertyTransaction.activeBuyerRoundId.
  activeForTransaction PropertyTransaction? @relation("ActiveBuyerRound")

  @@unique([transactionId, roundNumber])
  @@index([transactionId])
  @@index([status])
}

enum BuyerRoundStatus {
  active
  withdrawn
  superseded
}

// Audit + duration tracking for periods where a transaction is on hold.
// One row per hold period: startedAt is when status flipped to on_hold,
// endedAt is when it flipped back to active (null while currently on hold).
// Used by lib/services/hold-duration.ts to compute activeElapsedMs so that
// time-based signals (on_track, weeks elapsed, predicted exchange) freeze
// while paused, and so platform median calculations can subtract hold time.
model TransactionHoldPeriod {
  id            String    @id @default(cuid())
  transactionId String
  startedAt     DateTime
  startedById   String
  endedAt       DateTime?
  endedById     String?
  // Planned return date — when the user expects this hold to expire. NULL
  // means "indefinitely" (no auto-surface). Used by the hub's "expired
  // holds" widget: surfaces files whose plannedEndAt has passed but no
  // human has yet decided to take off hold or extend.
  plannedEndAt  DateTime?
  // Free-text why-on-hold, captured at hold time (optional). Surfaced on
  // the hub's holds-needing-attention card so the take-off/extend decision
  // can be made without opening the file.
  reason        String?
  createdAt     DateTime  @default(now())

  transaction PropertyTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  startedBy   User                @relation("HoldStartedBy", fields: [startedById], references: [id])
  endedBy     User?               @relation("HoldEndedBy", fields: [endedById], references: [id])

  @@index([transactionId, endedAt])
  @@index([endedAt, plannedEndAt])
}

enum TransactionStatus {
  draft
  active
  on_hold
  completed
  withdrawn
}

enum Tenure {
  freehold
  leasehold
}

enum PurchaseType {
  mortgage
  cash_buyer
  cash_from_proceeds
}

enum MilestoneState {
  locked
  available
