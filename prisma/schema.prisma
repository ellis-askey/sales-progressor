// â”€â”€â”€ Chain â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum ChainStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum InviteStatus {
  NOT_SENT
  SENT
  BOUNCED
  CLAIMED
  DECLINED
}

enum ChainHoldStatus {
  ON_HOLD
  INCOMPLETE
}

enum ChainWithdrawalStatus {
  WITHDRAWN
  REMARKETING
  WAITING
  BREAK_CHAIN
}

enum ChainNotificationType {
  LOST_BUYER
  LOST_PURCHASE
  ASKED_TO_WAIT
  // Closed-loop additions (2026-06-05 chain arc):
  // BUYER_FOUND — fired upward when a withdrawn file is relisted with a new
  //   buyer. Recipients are agents who received a LOST_BUYER (or were waiting/
  //   remarketing) in the original cascade. Variants of the copy branch on
  //   the recipient's prior response (WAITING / REMARKETING / none); WITHDRAW
  //   and BREAK_CHAIN responses skip the notification entirely.
  // CHAIN_DETACHED — fired to the highest claimed agent in the orphan segment
  //   when a withdrawal splits the chain (BUYER_WITHDREW or
  //   CHAIN_COLLAPSE_ABOVE detaches downstream; SELLER_WITHDREW detaches
  //   upstream). Informational — tells them their chain has been shortened.
  BUYER_FOUND
  CHAIN_DETACHED
}

// Why the file was marked withdrawn. Captured in the withdraw modal via a
// structured radio picker (free-text `fallThroughReason` is preserved as
// supplementary detail). Drives cascade direction:
//   BUYER_WITHDREW       → cascade UPWARD only; downstream detaches
//   SELLER_WITHDREW      → cascade DOWNWARD only; upstream detaches
//   CHAIN_COLLAPSE_ABOVE → no cascade from us (upstream already cascading);
//                          downstream detaches
//   OTHER                → cascade BOTH directions; neither side detaches
enum WithdrawalReason {
  BUYER_WITHDREW
  SELLER_WITHDREW
  CHAIN_COLLAPSE_ABOVE
  OTHER
}

enum ChainDirection {
  UPWARD
  DOWNWARD
}

model PropertyChain {
  id                String           @id @default(cuid())
  agencyId          String
  name              String?
  createdByUserId   String?
  status            ChainStatus      @default(ACTIVE)
  holdStatus        ChainHoldStatus?
  celebrationSentAt DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  agency        Agency                   @relation(fields: [agencyId], references: [id])
  createdBy     User?                    @relation("ChainCreatedBy", fields: [createdByUserId], references: [id])
  links         ChainLink[]
  notifications ChainNotificationQueue[]
}

model ChainLink {
  id              String  @id @default(cuid())
  chainId         String
  position        Int
  createdByUserId String?

  // Claim state
  transactionId   String?
  claimedByUserId String?
  claimedAt       DateTime?

  // Legacy fields (pre-v2 chain widget â€” do not use in new code)
  externalAddress String?
  externalStatus  String?

  // Stub data (v2 â€” used while unclaimed)
  stubPropertyAddress String?
  stubAgencyName      String?
  stubAgentEmail      String?
  stubAgentName       String?
  stubAgentPhone      String?
  stubNotes           String?

  // Invite tracking
  inviteStatus           InviteStatus @default(NOT_SENT)
  inviteToken            String?      @unique
  inviteTokenExpiresAt   DateTime?
  inviteSentAt           DateTime?
  inviteBouncedAt        DateTime?
  inviteUnsubscribedAt   DateTime?
  inviteDeclinedAt       DateTime?
  inviteResendCount      Int          @default(0)
  lastInviteSentByUserId String?

  // Deferred (v1.1)
  withdrawalStatus      ChainWithdrawalStatus?
  withdrawalRespondedAt DateTime?

  // Closed-loop chain arc (2026-06-05): when a withdrawal causes a chain
  // split (BUYER_WITHDREW detaches downstream into its own chain;
  // SELLER_WITHDREW detaches upstream; CHAIN_COLLAPSE_ABOVE detaches
  // downstream), every link in the orphan segment is moved to a new
  // PropertyChain row and gets these fields stamped. detachedFromChainId
  // is the chainId the link USED to be in; the link's `chainId` now points
  // at the new chain row. detachedAt is the moment of split. Drives
  // audit + the highest-link CHAIN_DETACHED notification recipient.
  detachedAt          DateTime?
  detachedFromChainId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chain                  PropertyChain            @relation(fields: [chainId], references: [id], onDelete: Cascade)
  transaction            PropertyTransaction?     @relation("ChainLinkToTransaction", fields: [transactionId], references: [id])
  activeForTransaction   PropertyTransaction?     @relation("TransactionActiveLink")
  createdBy              User?                    @relation("ChainLinkCreatedBy", fields: [createdByUserId], references: [id])
  claimedBy              User?                    @relation("ChainLinkClaimedBy", fields: [claimedByUserId], references: [id])
  lastInviteSentBy       User?                    @relation("ChainLinkLastInviteSentBy", fields: [lastInviteSentByUserId], references: [id])
  triggeredNotifications ChainNotificationQueue[] @relation("CascadeTrigger")
  receivedNotifications  ChainNotificationQueue[] @relation("CascadeRecipient")

  @@unique([chainId, position])
  @@index([transactionId])
  @@index([claimedByUserId])
  @@index([stubAgentEmail])
}

// ─── ChainNotificationQueue ───────────────────────────────────────────────────
// Step-wise chain withdrawal cascade — one row per directional notification.
// Created when:
//   - A chain-linked transaction is withdrawn (initial trigger fires two rows:
//     one upward LOST_BUYER, one downward LOST_PURCHASE — each to the nearest
//     claimed link in that direction, stopping at any WITHDRAWN link).
//   - An agent responds REMARKETING (fires one row: ASKED_TO_WAIT to the next
//     claimed link in the same direction as the incoming notification).
//   - An agent responds WITHDRAW (fires a fresh cascade from their now-WITHDRAWN
//     link, naturally limited by the stop-at-WITHDRAWN traversal).
// Response state lives per-row (not per-link), so one agent can hold multiple
// in-flight notifications (e.g. REMARKETING-down + ASKED_TO_WAIT-up).
// nudgeSentAt: set by /api/cron/drain-withdrawal-notifications 14 days after a
// WAITING response — single nudge, terminal thereafter.

model ChainNotificationQueue {
  id               String                 @id @default(cuid())
  chainId          String
  chain            PropertyChain          @relation(fields: [chainId], references: [id], onDelete: Cascade)
  triggeringLinkId String
  triggeringLink   ChainLink              @relation("CascadeTrigger", fields: [triggeringLinkId], references: [id])
  recipientLinkId  String
  recipientLink    ChainLink              @relation("CascadeRecipient", fields: [recipientLinkId], references: [id])
  recipientUserId  String
  recipientUser    User                   @relation(fields: [recipientUserId], references: [id])
  recipientEmail   String
  type             ChainNotificationType
  direction        ChainDirection
  emailSentAt      DateTime?
  response         ChainWithdrawalStatus?
  respondedAt      DateTime?
  nudgeSentAt      DateTime?
  createdAt        DateTime               @default(now())

  @@index([recipientUserId, response])
  @@index([response, respondedAt])
  @@index([chainId])
  @@index([recipientLinkId])
}

// ─── OutboundEmailQueue ───────────────────────────────────────────────────────
// Quiet-hours scheduling for milestone, celebration, and (post-A5) client-
// chase emails. Records are enqueued with scheduledFor = now() (business
// hours) or the next window. Cron drain processes sentAt IS NULL AND
// scheduledFor <= now(), checking suppression per recipient type.
//
// Exactly one of recipientUserId / recipientContactId must be set per row,
// enforced by a CHECK constraint at the database level. Two parallel unique
// indexes (on emailType+sourceId+recipientUserId and emailType+sourceId+
// recipientContactId) prevent duplicate enqueues per recipient per source
// per email type. Postgres treats NULL as distinct, so the User unique
// allows infinitely many Contact-recipient rows and vice versa.

model OutboundEmailQueue {
  id                 String    @id @default(cuid())
  emailType          String // "EXCHANGE" | "COMPLETION" | "CELEBRATION" | "CLIENT_CHASE" | ...
  sourceId           String // chainLinkId / chainId / contactId-keyed digest id
  recipientEmail     String
  recipientUserId    String? // claimed agent (existing recipients)
  recipientContactId String? // client contact (vendor / purchaser etc.) — added A5
  payload            Json // serialised at enqueue time; drain needs no extra DB queries
  scheduledFor       DateTime
  sentAt             DateTime?
  errorAt            DateTime?
  errorMessage       String?
  createdAt          DateTime  @default(now())

  // SendGrid Event Webhook delivery status. Populated by
  // /api/webhooks/sendgrid-bounce when delivery / deferred / bounce /
  // dropped events fire for a message we sent with customArgs.queueId.
  // sentAt = handed to SendGrid; these = what actually happened after.
  // All nullable → existing rows ("Sent (status unknown)") work unchanged.
  deliveredAt    DateTime?
  deferredAt     DateTime?
  deferredCount  Int       @default(0)
  deferredReason String?
  bouncedAt      DateTime?
  bouncedReason  String?
  blockedAt      DateTime?
  blockedReason  String?

  // Audit: when an agent edits the pending payload via the email preview
  // modal, these track who/when. Null on rows that were never edited.
  // The edit overwrites payload in place — the drain reads JSON so edits
  // propagate naturally. No version history for v1.
  editedAt   DateTime?
  editedById String?

  // Relations — back-refs added on the User and Contact models in their
  // sections of the schema. ON DELETE CASCADE so deleting a user or contact
  // clears any pending queued mail (orphan-prevention).
  recipientUser    User?    @relation("OutboundEmailQueueRecipientUser", fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipientContact Contact? @relation("OutboundEmailQueueRecipientContact", fields: [recipientContactId], references: [id], onDelete: Cascade)
  editedBy         User?    @relation("EmailQueueEditedBy", fields: [editedById], references: [id], onDelete: SetNull)

  @@unique([emailType, sourceId, recipientUserId])
  @@unique([emailType, sourceId, recipientContactId])
  @@index([sentAt, scheduledFor])
}

// ─── DirectorInvitation ───────────────────────────────────────────────────────

model DirectorInvitation {
  id               String    @id @default(cuid())
