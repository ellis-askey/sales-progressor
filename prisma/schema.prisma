// â”€â”€â”€ NegotiatorInvitation â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Created when a director adds a negotiator. The negotiator receives an email
// with a link to set their own password. The User row is created immediately
// (password: null) so the negotiator appears in the team list as "pending".

model NegotiatorInvitation {
  id               String    @id @default(cuid())
  agencyId         String
  invitedByUserId  String
  negotiatorName   String
  negotiatorEmail  String
  token            String    @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  agency     Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  invitedBy  User   @relation("NegotiatorInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy User?  @relation("NegotiatorInvitationsAccepted", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([agencyId])
  @@index([token])
  @@index([negotiatorEmail])
}

// ── FileTimeSession ──────────────────────────────────────────────────────────
// Tracks engaged (tab visible + window focused) time per user per transaction.
// Sessions < 10s engaged are discarded on close. Stale open sessions (no
// heartbeat for 5min) are auto-closed by /api/cron/file-time-close.

model FileTimeSession {
  id                  String    @id @default(cuid())
  transactionId       String
  userId              String
  agencyId            String
  startedAt           DateTime  @default(now())
  endedAt             DateTime?
  lastActivityAt      DateTime  @default(now())
  engagementIntervals Json      @default("[]")
  totalEngagedSeconds Int?
  userAgent           String?
  closedReason        String?

  transaction PropertyTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id])
  agency      Agency              @relation(fields: [agencyId], references: [id])

  @@index([transactionId, userId])
  @@index([userId, startedAt])
  @@index([agencyId, startedAt])
}

// Portal-side twin of FileTimeSession — measures real engaged time a portal
// CLIENT (a Contact, token-authenticated, not a User) spends on their portal.
// FileTimeSession can't be reused because its userId/agencyId are non-null User
// / Agency FKs; portal visitors have neither. engagementIntervals + the <10s
// discard + heartbeat-timeout close mirror the agent system exactly, so the
// two aggregate the same way. Added 2026-08-13 — no backfill, so it only
// records from ship date forward.
model PortalTimeSession {
  id                  String    @id @default(cuid())
  transactionId       String
  contactId           String
  startedAt           DateTime  @default(now())
  endedAt             DateTime?
  lastActivityAt      DateTime  @default(now())
  engagementIntervals Json      @default("[]")
  totalEngagedSeconds Int?
  userAgent           String?
  closedReason        String?

  transaction PropertyTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  contact     Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([transactionId, contactId])
  @@index([contactId, startedAt])
  @@index([transactionId, startedAt])
}

// ── SystemNotification ───────────────────────────────────────────────────────
// One-shot notification flags. Each `key` is a unique identifier for a single
// platform-level event we never want to fire twice (e.g. "medians_ready" —
// the first time we have enough completion data to swap the hardcoded
// MILESTONE_DURATION_MEDIANS for learned values). Cron jobs check for the
// row's existence before doing any expensive computation, and write the row
// after enqueueing the notification. Resetting requires deleting the row
// manually (intended — these are platform-lifetime events).

model SystemNotification {
  id        String   @id @default(cuid())
  key       String   @unique
  firedAt   DateTime
  createdAt DateTime @default(now())
}

// ── Notification ─────────────────────────────────────────────────────────────
// Per-user, per-event in-app notification queue. DISTINCT from
// SystemNotification (which is a one-shot platform flag with no userId).
// Used by SPBell on the internal dashboard to surface confirmation events on
// files assigned to the current Sales Progressor. `payload` is type-specific
// JSON; `readAt` is set when the user clicks the bell.
//
// Types currently in use:
//   - "portal_milestone_confirm"            (buyer/seller confirmed via portal)
//   - "agent_outsourced_milestone_confirm"  (agent confirmed step on outsourced file)

model Notification {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  transactionId String?
  transaction   PropertyTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  payload       Json
  createdAt     DateTime             @default(now())
  readAt        DateTime?

  @@index([userId, readAt, createdAt])
}

// ── ClientChaseState ──────────────────────────────────────────────────────────
// Per-(transaction, contact, milestone) state for the automated client-chase
// pipeline (Sub-arc B). The cron reads this table to decide who to chase,
// who to escalate, and who to hand back to the agent via the fail-soft
// helper. NOT touched by Sub-arc A (table created in B2; no callers until B7).
//
// Lifecycle:
//   1. Cron finds (transaction, contact, milestone) tuples eligible for the
//      first chase → creates a row with status="active", chaseCount=0,
//      firstChasedAt=null. (Created when the first chase is about to send;
//      not pre-created for every eligible row.)
//   2. Each chase send: chaseCount++, lastChasedAt=now. firstChasedAt set on
//      the first send.
//   3. Each client engagement (portal visit / note / date-set): lastEngagedAt
//      = now. The 14-day silence window restarts from this point.
//   4. Milestone confirmed (by anyone) → status="completed". Row stays for
//      audit; not deleted.
//   5. Escalation ceiling hit (chaseCount >= 2 OR (now - firstChasedAt) >=
//      14d AND lastEngagedAt < firstChasedAt) → status="escalated"; the
//      A4 fail-soft helper creates an agent ChaseTask with the right kind.
//   6. Contact unsubscribes → status="opted_out"; A4 fail-soft fires with
//      kind="client_opted_out".
//
// Status values (free-form String for forward-compat):
//   - "active"     — eligible for chase
//   - "completed"  — milestone confirmed; row inert (kept for audit)
//   - "escalated"  — ceiling hit; agent ChaseTask exists
//   - "opted_out"  — contact unsubscribed; agent ChaseTask exists

model ClientChaseState {
  id            String    @id @default(cuid())
  transactionId String
  contactId     String
  milestoneCode String
  chaseCount    Int       @default(0)
  firstChasedAt DateTime?
  lastChasedAt  DateTime?
  lastEngagedAt DateTime?
  status        String    @default("active")
  // Human-readable reason for the current status. Set when the row leaves
  // "active" (escalation reason: chase_count / silence_14d; cancellation
  // reason: milestone_reversed / milestone_completed / relist / hold /
  // portal_confirmed). Null on active rows and on rows whose transition
  // pre-dates this field. Read by the file's chase-history panel to
  // explain "why did this stop" without the reader inferring from silence.
  statusReason  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Phase 0 shadow attribution. Stamped when contact.roleType =
  // 'purchaser'. Not read anywhere yet.
  buyerRoundId String?
  buyerRound   BuyerRound? @relation(fields: [buyerRoundId], references: [id], onDelete: SetNull)

  transaction PropertyTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  contact     Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([transactionId, contactId, milestoneCode])
  @@index([status, lastChasedAt])
  @@index([contactId, status])
  @@index([buyerRoundId])
}

// Per-(file, side, milestone) chase state for SOLICITOR confirmation emails.
// Mirrors ClientChaseState but keyed by side (vendor/purchaser) rather than a
// contact, because a solicitor is reused across files (no portalToken). Drives
// the softer solicitor cadence (grace 5 working days, repeat 7, cap 2, then
// escalate to the team). See docs/active/solicitor-confirm/scope.md.
model SolicitorChaseState {
  id            String        @id @default(cuid())
  transactionId String
  side          MilestoneSide
  milestoneCode String
  chaseCount    Int           @default(0)
  firstChasedAt DateTime?
  lastChasedAt  DateTime?
  // Set when a solicitor gives an expected date — suppresses further nudges
  // until then (parallels the client "set a date" snooze).
  snoozeUntil   DateTime?
  // Set when the step is confirmed/completed or otherwise no longer due.
  resolvedAt    DateTime?
  status        String        @default("active")
  statusReason  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  transaction PropertyTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, side, milestoneCode])
  @@index([status, lastChasedAt])
  @@index([transactionId])
}

// Global singleton holding the editable solicitor-chase cadence. One row
// (id = "singleton"). Matches how client reminder timing is platform-global
// rather than per-agency. Editable from Settings → Automation (Stage 2c).
//
// 2026-08-10: grace + repeat here retained as GLOBAL FALLBACK only. The
// live cadence is now per-code in SolicitorReminderRule; this singleton is
// only read when no rule row exists for a given code (defensive: if a new
// solicitor-owned code lands before its rule is seeded, the engine still
// has cadence values to fall back on).
model SolicitorChaseSettings {
  id               String   @id @default("singleton")
  enabledByDefault Boolean  @default(true)
  graceWorkingDays Int      @default(5)
  repeatDays       Int      @default(7)
  maxChases        Int      @default(2)
  updatedAt        DateTime @updatedAt
  updatedById      String?
}

// Per-milestone chase cadence for solicitor-owned steps. One row per code
// (VM5, VM7, ... PM25 — 26 total in v1). Each row tunes:
//   - graceWorkingDays: how long after the anchor before the first chase
//   - repeatWorkingDays: how long between subsequent chases (WORKING days,
//     not calendar — so a Friday send comes back the following Thursday,
//     not Tuesday; matches how solicitors experience the cadence)
//   - maxChases: hard cap before escalation to the assigned agent
//   - active: master off-switch per code (false = never chase this step)
//   - anchorMilestoneCode: null = anchor on this milestone's direct
//     prerequisite completedAt (default). Set to a specific code to
//     anchor elsewhere — e.g. PM7 (draft pack received) anchors on VM7
//     (draft pack ISSUED) rather than PM4 (buyer paid money).
//   - useAnchorEventDate: true = anchor on the referenced milestone's
//     eventDate instead of its completedAt. Falls back to completedAt
//     when eventDate is null (e.g. PM6 desktop valuations). Used only
//     for PM11 mortgage-offer in the seed.
//
// Editable from Settings → Automation (Ellis reviews all cadences there).
model SolicitorReminderRule {
  id                  String   @id @default(cuid())
  milestoneCode       String   @unique
  graceWorkingDays    Int      @default(5)
  repeatWorkingDays   Int      @default(5)
  maxChases           Int      @default(2)
  active              Boolean  @default(true)
  anchorMilestoneCode String?
  useAnchorEventDate  Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ─── Enquiries tracker ──────────────────────────────────────────────────────
// One per transaction's enquiries loop. See
// docs/active/enquiries-stage-rework-SPEC.md.
//
// Replaces the deleted per-round enquiry milestones (buyer PM15-19, seller
// VM11-15) with a single loop that carries a "whose court" state, an optional
// unlabelled movement log, and one optional outstanding note. "Satisfied"
// stays a milestone (PM20 + the new seller mirror); this tracker is the messy
// middle the old ticks tried and failed to model.

enum EnquiryCourt {
  seller_solicitor
  buyer_solicitor
}

enum EnquiryMovementSource {
  progressor      // logged by the internal team / agent
  buyer_report    // buyer told us (portal or WhatsApp, logged by us)
  seller_report   // seller told us (portal or WhatsApp, logged by us)
  solicitor_reply // a solicitor replied to a chase
}

enum EnquiryMovementStatus {
  pending   // client report awaiting progressor review (Phase 2)
  accepted  // counts: resets the chase clock, can flip the court
  dismissed // reviewed and rejected
}

// ─── OnwardTracker ───────────────────────────────────────────────────────────
//
// A seller's REPORTED onward-purchase progress, held on their own sale file as a
// stand-in until the agent handling that onward purchase claims the chain link
// above them (Stage 3 pre-fills their reconciliation wizard from this, then the
// tracker retires as `superseded` and the real file owns the truth). This is
// never a real transaction — everything here is second-hand ("reported") and
// must be labelled so wherever it renders, and is NEVER exposed across the
// agency boundary into the shared chain view (Q6). One level of chain only (Q9).
// Full spec: docs/active/onward-visibility/00-discovery.md.
model OnwardTracker {
  id                String              @id @default(cuid())
  transactionId     String              @unique // the seller's own sale file
  // The two facts that decide which purchaser steps apply — same axes the real
  // engine uses via computeAutoNrCodes (lib/milestone-auto-nr.ts). Nullable
  // until the seller/agent tells us; the step list stays gated until both set.
  tenure            Tenure?
  purchaseType      PurchaseType?
  isShareOfFreehold Boolean             @default(false)
  status            OnwardTrackerStatus @default(active)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  transaction PropertyTransaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  steps       OnwardStepConfirmation[]
}

enum OnwardTrackerStatus {
  active
  exchanged
  completed
  abandoned
  superseded // the agent above claimed; their real file now owns the truth
}

// One row per REPORTED-complete onward step. Keyed to a purchaser-side
// MilestoneDefinition.code (plain scalar, no relation — resolved on read, and
// mapped code→id at claim-time reconciliation in Stage 3). Presence of a row =
// that step is reported complete. Availability/ordering is computed on read from
// the real predecessorCode chain, not stored.
model OnwardStepConfirmation {
  id                   String              @id @default(cuid())
  trackerId            String
  milestoneCode        String // a purchaser-side MilestoneDefinition.code, e.g. "PM7"
  // Real-world date the step happened, if known. Null = "reported done, date
  // unknown" (mirrors reconciliation's null-date semantics).
  eventDate            DateTime?
  source               OnwardConfirmSource
  // Whoever confirmed it — the seller's Contact, or the agent/user. One is set.
  confirmedByContactId String?
  confirmedByUserId    String?
  confirmedAt          DateTime            @default(now())
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  tracker OnwardTracker @relation(fields: [trackerId], references: [id], onDelete: Cascade)

  @@unique([trackerId, milestoneCode])
  @@index([trackerId])
}

enum OnwardConfirmSource {
  seller
  agent
}

model EnquiryTracker {
  id              String       @id @default(cuid())
  transactionId   String       @unique
  // Whose court the ball is in. Defaults to the seller's solicitor at "raised"
  // (they owe the replies). Flips only on a real signal (a solicitor reply, a
  // client report, or a progressor override) — never guessed.
  currentlyWith   EnquiryCourt @default(seller_solicitor)
  // One free-text scratch line ("waiting on: management pack, FENSA cert").
  outstandingNote String?
  openedAt        DateTime     @default(now())
  // Silence is measured from lastMovementAt ?? openedAt. Logging a movement
  // resets it, which restarts the chase cadence.
  lastMovementAt  DateTime?
  lastChasedAt    DateTime?
  chaseCount      Int          @default(0)
  escalatedAt     DateTime?
  snoozedUntil    DateTime?
  // Set when enquiries are marked satisfied — the loop is closed.
  closedAt        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  transaction PropertyTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  movements   EnquiryMovement[]

  @@index([currentlyWith, closedAt])
  @@index([closedAt, lastMovementAt])
}

// Who the raise-chase last nudged, so the cadence can alternate buyer/solicitor.
enum RaiseChaseTarget {
  buyer
  buyer_solicitor
}

// The "get enquiries raised" chase (enquiries rework). Runs BEFORE the enquiries
// tracker exists — it chases to get the buyer's solicitor to raise enquiries in
// the first place, nudging the buyer first then their solicitor, escalating to
// the file owner if it stalls. Opens when searches are ordered, closes the
// moment enquiries are raised (then the tracker takes over the reply loop).
// One per transaction. The "hold until an expected date" lives on the PM14
// MilestoneCompletion.expectedDate, not here.
model EnquiryRaiseChase {
  id            String            @id @default(cuid())
  transactionId String            @unique
  // Clock anchor: set when searches are ordered. All timings are working days
  // measured from here.
  openedAt      DateTime          @default(now())
  lastNudgedAt  DateTime?
  lastTarget    RaiseChaseTarget?
  nudgeCount    Int               @default(0)
  // Set once when the 2-week + 3-day ceiling escalates to the file owner.
  escalatedAt   DateTime?
  // Set when enquiries are marked raised — the chase is done.
  closedAt      DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  transaction PropertyTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([closedAt])
}

// Records when a client opens a follow-up email to their conveyancer (taps
// "Open in email"). Not proof of a send — the CC'd copy filed via the inbox
// sync is that — but it powers the Command Centre opened-vs-sent usage view.
model FollowupTap {
  id            String   @id @default(cuid())
  transactionId String
  contactId     String?
  side          String // "vendor" | "purchaser"
  stepCode      String // milestone code, or "enquiries"
  state         String // calm | check_in | behind
  tappedAt      DateTime @default(now())

  transaction PropertyTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([tappedAt])
}

// Which chaser sent it, and to whom. Used by the enquiries-chase experiment
// board (Command Centre) to measure whether chasing actually works.
enum ChaseSendKind {
  raise // "get enquiries raised" chase
  reply_loop // enquiries reply-loop tracker chase
}

enum ChaseSendRecipient {
  buyer // client nudge (raise chase only)
  seller_solicitor
  buyer_solicitor
}

enum ChaseResponseType {
  update // left a written update via the link
  date // gave an expected date via the link
  confirm // confirmed the step (raised / satisfied) via the link
}

// One row per chase email actually sent. The experiment log: did they open the
// link, did they act (and how), or did they reply by email (a manual founder
// tick). Written by the chase crons on a successful send.
model ChaseSend {
  id            String             @id @default(cuid())
  transactionId String
  kind          ChaseSendKind
  recipient     ChaseSendRecipient
  recipientName String? // solicitor firm (or buyer name), for the board
  sentAt        DateTime           @default(now())
  // Set when the recipient opens their /s/ link after this send.
  openedAt      DateTime?
  // Set when they take an action via the link.
  respondedAt   DateTime?
  responseType  ChaseResponseType?
  // Manual: the founder ticks this when the solicitor replied by email instead
  // of using the link.
  repliedByEmailAt DateTime?
  createdAt     DateTime           @default(now())

  transaction PropertyTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([sentAt])
  @@index([transactionId])
  @@index([kind, sentAt])
}

model EnquiryMovement {
  id              String                @id @default(cuid())
  trackerId       String
  // Unlabelled: no round number, no initial-vs-additional — the distinction we
  // often can't observe. Just a plain one-line record.
  note            String
  occurredAt      DateTime              @default(now())
  source          EnquiryMovementSource
  // Set when this movement moves the ball to the other side.
  flipsCourtTo    EnquiryCourt?
  status          EnquiryMovementStatus @default(accepted)
  // Null for client reports. Plain id (no FK), matching SolicitorChaseSettings.updatedById.
  createdByUserId String?
  createdAt       DateTime              @default(now())

  tracker EnquiryTracker @relation(fields: [trackerId], references: [id], onDelete: Cascade)

  @@index([trackerId, occurredAt])
  @@index([status])
}

// ─── Payments ─────────────────────────────────────────────────────────────
// Scaffolding-only in this migration: tables present, no behaviour wired yet.
// See docs/active/payments-build-plan.md for the staged rollout.

enum InvoiceStatus {
  building // current month, accruing
  issued // month closed, Stripe invoice created
  paid // Stripe webhook confirmed payment
  failed // Stripe webhook confirmed failure
  void // manually voided
}

model Invoice {
  id              String        @id @default(cuid())
  agencyId        String
  agency          Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  // First-of-month timestamp UTC marking the billing period.
  // IMPORTANT: the rule for which billing month an exchange falls into is
  // computed in Europe/London (so an exchange at 00:30 on the 1st London
  // time doesn't land on last month's invoice). Storage stays UTC; the
  // boundary computation lives in lib/billing/period.ts (PR 5).
  monthStart      DateTime
  status          InvoiceStatus @default(building)
  issuedAt        DateTime?
  paidAt          DateTime?
  stripeInvoiceId String?
  lines           InvoiceLine[]
  appliedCredits  CreditNote[]  @relation("InvoiceCreditApplications")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([agencyId, monthStart])
  @@index([status])
}

enum InvoiceLineKind {
  in_house_fee
  outsourced_fee
  credit_applied
}

model InvoiceLine {
  id            String               @id @default(cuid())
  invoiceId     String
  invoice       Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  transactionId String?
  transaction   PropertyTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  kind          InvoiceLineKind
  description   String
  // amountPence is ex-VAT when the agency is VAT-registered at issuance time;
  // inclusive otherwise. Rendering reads agency.vatRegisteredAt to decide.
  amountPence   Int
  vatPence      Int                  @default(0)
  totalPence    Int // amountPence + vatPence
  createdAt     DateTime             @default(now())

  @@index([invoiceId])
  @@index([transactionId])
}

// Pricing disclosure text shown to the director at first card capture.
// Ships EMPTY in PR 1 — its first row is inserted only when the actual
// disclosure copy is designed (separate task before PR 6 ships).
// Never seed with placeholder text — see payments-build-plan.md PR 6 flag.
model TermsVersion {
  id               String                   @id @default(cuid())
  versionTag       String                   @unique // e.g. "2026-05-payments-v1"
  // JSONB array of { heading: string, body: string }. Structured so the
  // renderer maps over sections cleanly + future versions can change wording
  // without breaking the parser. See lib/billing/terms-sections.ts for the
  // TypeScript type.
  bodySections     Json
  effectiveFrom    DateTime
  createdAt        DateTime                 @default(now())
  acknowledgements PricingAcknowledgement[]
}

// One row per director acknowledgement of the pricing disclosure.
// The acknowledgedByName + acknowledgedByEmail strings ARE the audit record;
// the FK to User is a convenience link that nulls on user delete (GDPR-safe).
model PricingAcknowledgement {
  id                   String       @id @default(cuid())
  agencyId             String
  agency               Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  acknowledgedByUserId String?
  acknowledgedBy       User?        @relation(fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)
  acknowledgedByName   String // denormalised at acknowledgement — the audit record
  acknowledgedByEmail  String // denormalised at acknowledgement — the audit record
  termsVersionId       String
  termsVersion         TermsVersion @relation(fields: [termsVersionId], references: [id])
  acknowledgedAt       DateTime     @default(now())

  @@index([agencyId])
}

// Credit against a future invoice. Written when an exchange that was already
// invoiced gets reversed via executeUndoMilestone (PR 4). Model is credit-only:
// no cash refunds (per locked model in payments-build-plan.md).
model CreditNote {
  id                 String               @id @default(cuid())
  agencyId           String
  agency             Agency               @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  transactionId      String?
  transaction        PropertyTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  amountPence        Int
  reason             String // e.g. "Exchange reversed post-invoice — VM19 undone on 2026-06-12"
  appliedToInvoiceId String?
  appliedToInvoice   Invoice?             @relation("InvoiceCreditApplications", fields: [appliedToInvoiceId], references: [id])
  appliedAt          DateTime?
  createdAt          DateTime             @default(now())

  @@index([agencyId])
  @@index([appliedToInvoiceId])
}

// Record of an email sent TO an agency user (or an external agent) that does
// NOT already leave a trail on a file. Client-facing sends are logged via
// OutboundEmailQueue + file activity; agent-facing sends previously fired
// straight through sendEmail with no record. Written best-effort by
// sendAgentEmail (lib/email/agent-log.ts) — a logging failure never blocks the
// send. Surfaced in the Command Centre at /command/agent-emails. Log starts at
// ship date; no backfill (SendGrid activity retention is ~3 days).
model AgentEmailLog {
  id     String   @id @default(cuid())
  sentAt DateTime @default(now())

  toEmail String

  // The agency user this went to, when known (null for external agents on
  // chain invites). SetNull so deleting a user does not lose the audit row.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)

  // Kind taxonomy (string, not enum, so new senders can log without a
  // migration): weekly_brief, morning_digest, retention, welcome,
  // claim_welcome, team_invite, team_accepted, portal_message, domain_auth,
  // verified_email, chain_invite, password_reset.
  kind    String
  subject String

  // Rendered bodies. NULL for redacted kinds (password_reset carries a live
  // reset link — we store kind + subject + recipient only).
  text String?
  html String?

  transactionId String?
  transaction   PropertyTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  meta Json?

  @@index([sentAt])
  @@index([kind])
  @@index([agencyId])
}
