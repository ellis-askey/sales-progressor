model ChaseTask {
  id            String          @id @default(cuid())
  transactionId String
  reminderLogId String
  assignedToId  String?
  dueDate       DateTime
  status        ChaseTaskStatus @default(pending)
  priority      TaskPriority    @default(normal)
  chaseCount    Int             @default(0)
  // Set on every real chase increment. NULL means "never chased yet".
  // Escalation requires chaseCount >= rule.escalateAfterChases AND
  // (now - lastChasedAt) >= rule.repeatEveryDays — i.e. another full
  // cycle has elapsed since the last actual chase. The engine NEVER
  // ticks chaseCount on calendar arithmetic alone; only real chase
  // actions (button click, manual record, outbound email, client-chase
  // digest enqueue) move it. See docs/active/honest-chase-count.
  lastChasedAt  DateTime?
  notes         String?
  // Discrete-kind marker for tasks the system handed to the agent because
  // automated chasing failed. Null for normal engine-created tasks. First
  // value: "client_opted_out" — set when a client unsubscribed (A2/A3) and
  // a chase that would have emailed them was redirected to the agent. UI
  // renders a yellow chip on the work-queue row when this is set.
  // Free-form String (not a Prisma enum) so future fallback kinds can be
  // added without a schema migration.
  fallbackKind  String?
  // Free-text reason captured on a MANUAL escalation. Null for automatic
  // engine-triggered escalations (which flip on the chaseCount + graceDays
  // rule and have no user-supplied reason). Cleared when the task is
  // chased-through (applyChaseToTask resets priority to normal) or
  // completed. Surfaced by a tooltip on the "Escalated" chip so the file
  // owner can see why the row was manually flagged.
  escalationReason String?
  escalatedAt      DateTime?
  escalatedById    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Phase 0 shadow attribution. Inherited from the parent ReminderLog's
  // attribution. Not read anywhere yet.
  buyerRoundId String?
  buyerRound   BuyerRound? @relation(fields: [buyerRoundId], references: [id], onDelete: SetNull)

  transaction    PropertyTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  reminderLog    ReminderLog         @relation(fields: [reminderLogId], references: [id])
  assignedTo     User?               @relation(fields: [assignedToId], references: [id])
  escalatedBy    User?               @relation("ChaseTaskEscalatedBy", fields: [escalatedById], references: [id])
  communications OutboundMessage[]

  @@index([transactionId])
  @@index([status, dueDate])
  @@index([priority, status])
  @@index([buyerRoundId])
}

enum ChaseTaskStatus {
  pending
  done
  cancelled
  inactive
}

enum TaskPriority {
  normal
  escalated
}

