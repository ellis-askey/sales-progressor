// Recommended-services directory + client-submitted quote requests. Started
// as "surveyors" (2026-08-09). ProviderKind will grow to cover electricians,
// gas engineers, EPC, etc. Client entry point is /quote/[token]. Admin
// surface is /command/providers.
model ProviderFirm {
  id        String       @id @default(cuid())
  kind      ProviderKind
  name      String
  email     String
  phone     String?
  website   String?
  // Path in the provider-logos Supabase bucket. Signed URLs served via
  // lib/supabase-storage.ts. Nullable — display renders a monogram tile
  // when absent.
  logoPath  String?
  notes     String?
  // Client-facing trust signals shown on the survey-quote card (no contact
  // details — clients request quotes through us, they don't contact directly).
  ricsRegulated   Boolean @default(false)
  establishedYear Int?
  turnaround      String? // e.g. "Quotes within 2 working days"
  // Sales Progressor's own default provider of this kind — the one shown as
  // the fallback on outsourced files where the agency hasn't set their own
  // (mortgage broker card, 2026-08-21). Only meaningful per kind; there's one
  // TSP-default broker today. Ticked from /command/providers.
  tspDefault Boolean      @default(false)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  coverage      ProviderCoverage[]
  serviceTypes  ProviderFirmServiceType[]
  quoteRequests QuoteRequest[]

  @@index([kind, active])
}

// One row per outward code (e.g. "SW1", "EN8") a firm covers. Matched against
// outwardCode(transaction.propertyPostcode) at quote-picker time.
model ProviderCoverage {
  id          String   @id @default(cuid())
  providerId  String
  outwardCode String
  createdAt   DateTime @default(now())

  provider ProviderFirm @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, outwardCode])
  @@index([outwardCode])
}

// Master list of service types clients choose from. Editable per kind in
// /command/providers/service-types. Seeded with 4 surveyor rows.
model ProviderServiceType {
  id          String       @id @default(cuid())
  kind        ProviderKind
  label       String
  description String?
  sortOrder   Int          @default(0)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  firms         ProviderFirmServiceType[]
  quoteRequests QuoteRequest[]

  @@index([kind, active, sortOrder])
}

model ProviderFirmServiceType {
  providerId    String
  serviceTypeId String
  createdAt     DateTime @default(now())

  provider    ProviderFirm        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceType ProviderServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  @@id([providerId, serviceTypeId])
}

// One row per (client, firm) quote submission. Client selecting multiple
// firms creates multiple rows in a single submit. status transitions are
// admin-only from /command/providers/quotes.
model QuoteRequest {
  id            String       @id @default(cuid())
  transactionId String
  contactId     String
  providerId    String
  serviceTypeId String
  kind          ProviderKind

  contactMethod QuoteContactMethod
  contactWindow QuoteContactWindow
  urgency       QuoteUrgency
  notes         String?

  // Snapshotted at submit time so the record survives contact/property edits.
  clientName          String
  clientEmail         String
  clientPhone         String?
  propertyAddress     String
  propertyPostcode    String
  propertyOutwardCode String
  // Snapshotted property facts the surveyor needs to price the job. Nullable
  // because a file may not have them recorded yet at request time.
  pricePence          Int?
  tenure              Tenure?

  status            QuoteRequestStatus @default(pending)
  statusReason      String?
  statusChangedAt   DateTime?
  statusChangedById String?
  // Set when the firm is marked booked from the survey-booked step. Distinct
  // from statusChangedAt so a later "won" doesn't overwrite the booking date.
  bookedAt          DateTime?

  // Filled in on "Won". saleFeePence = what surveyor charged client;
  // referralFeePence auto-computed as 10% but overridable in the CC form.
  saleFeePence           Int?
  referralFeePence       Int?
  referralFeeCollected   Boolean   @default(false)
  referralFeeCollectedAt DateTime?

  emailMessageId String?
  emailSentAt    DateTime?

  // Stamped by the retention cron 12 months after a terminal status
  // (won/lost/expired). PII columns (clientName/Email/Phone) are wiped;
  // aggregate columns (postcode, kind, fees) kept for analytics.
  anonymisedAt DateTime?

  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transaction     PropertyTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  contact         Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  provider        ProviderFirm        @relation(fields: [providerId], references: [id])
  serviceType     ProviderServiceType @relation(fields: [serviceTypeId], references: [id])
  statusChangedBy User?               @relation("QuoteRequestStatusChangedBy", fields: [statusChangedById], references: [id])

  @@index([transactionId])
  @@index([contactId])
  @@index([providerId, status])
  @@index([status, submittedAt])
}

enum ProviderKind {
  surveyor
  mortgage_broker
}

enum QuoteRequestStatus {
  pending
  booked      // the buyer chose this firm; referral in play (fee not yet settled)
  won
  not_chosen  // this firm quoted but the buyer booked a DIFFERENT firm of ours —
              // neutral, NOT a loss (we still placed the business)
  lost        // the buyer booked outside our network (or no referral to us)
  expired
}

enum QuoteContactMethod {
  phone
  email
  either
  text
  whatsapp
}

enum QuoteContactWindow {
  anytime
  morning
  afternoon
  evening
}

enum QuoteUrgency {
  asap
  within_week
  flexible
}

enum ContactRole {
  vendor
  purchaser
  solicitor
  broker
  other
}

// â”€â”€â”€ MilestoneDefinition â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model MilestoneDefinition {
  id                String        @id @default(cuid())
  code              String        @unique
  name              String
  side              MilestoneSide
  orderIndex        Int
  blocksExchange    Boolean       @default(true)
  eventDateRequired Boolean       @default(false)
  predecessorCode   String?
  canBeMarkedNr     CanBeMarkedNr @default(never)
  summaryTemplate   String        @default("")
  weight            Decimal       @default(0)
  createdAt         DateTime      @default(now())

  completions   MilestoneCompletion[]
  reminderRules ReminderRule[]        @relation("AnchorMilestone")
}

enum MilestoneSide {
  vendor
  purchaser
}

model MilestoneCompletion {
  id                            String         @id @default(cuid())
  transactionId                 String
  milestoneDefinitionId         String
  state                         MilestoneState @default(locked)
  completedAt                   DateTime?
  eventDate                     DateTime?
  // Client-supplied speculation about WHEN a milestone will happen — set
  // via the chase confirm page's "Set a date" control (Sub-arc B / B5).
  // Distinct from eventDate (which is the REAL date when complete) and
  // from completedAt (when our system marked it complete). Cleared when
  // the milestone is later confirmed (so it doesn't shadow the real date).
  // Allows the chase pipeline to track "client said 15 June" engagement
  // without prematurely marking the milestone complete.
  expectedDate                  DateTime?
  notRequiredReason             String?
  // NR-specific attribution. Distinct from completedById/completedAt which
  // track the last actor to flip TO the "complete" state. When a milestone
  // moves to "not_required", these capture who did it + when — so the
  // timeline can render "Marked not required by Sam · 3 Jul" without
  // conflating NR with a real completion. Cleared on undo.
  notRequiredById               String?
  notRequiredAt                 DateTime?
  completedById                 String?
  confirmedByPortal             Boolean        @default(false)
  // The specific Contact who confirmed via their own portal link. Each client
  // has their own token, so a portal confirm knows exactly who did it — this
  // stores their id so the timeline can name them, not just "Client". Plain
  // scalar (no relation) — the name is resolved on read.
  confirmedByContactId          String?
  // Solicitor-confirmer attribution (solicitor-confirm feature). Set when a
  // step is confirmed by a solicitor via their /s/<token> link, so the
  // timeline can render "confirmed by {firm}" — distinct from a client portal
  // confirm (confirmedByPortal) or an agent confirm (completedById). Both null
  // for agent/client confirms. See docs/active/solicitor-confirm/scope.md.
  confirmedBySolicitorFirmId    String?
  confirmedBySolicitorContactId String?
  summaryText                   String?
  reconciledAtExchange          Boolean        @default(false)
  reconciledAtClaim             Boolean        @default(false)
  outOfOrderCompletion          Boolean        @default(false)
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt

  // Phase 1 of the relist feature — purchaser rows are now scoped per
  // BuyerRound. Vendor (file-level) rows keep buyerRoundId NULL.
  // Uniqueness is enforced by two partial indexes in
  // 20260604000000_buyer_round_milestone_uniqueness/migration.sql
  // (Prisma cannot express partial uniques in schema). The compound
  // (transactionId, milestoneDefinitionId) is kept as a regular index
  // for read performance — many callsites still filter by it.
  buyerRoundId String?
  buyerRound   BuyerRound? @relation(fields: [buyerRoundId], references: [id], onDelete: SetNull)

  transaction                 PropertyTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  milestoneDefinition         MilestoneDefinition @relation(fields: [milestoneDefinitionId], references: [id])
  completedBy                 User?               @relation("CompletedBy", fields: [completedById], references: [id])
  notRequiredBy               User?               @relation("NotRequiredBy", fields: [notRequiredById], references: [id])
  confirmedBySolicitorFirm    SolicitorFirm?      @relation("MilestoneConfirmedByFirm", fields: [confirmedBySolicitorFirmId], references: [id])
  confirmedBySolicitorContact SolicitorContact?   @relation("MilestoneConfirmedByContact", fields: [confirmedBySolicitorContactId], references: [id])

  @@index([transactionId, milestoneDefinitionId])
  @@index([transactionId, completedAt])
  @@index([buyerRoundId])
}

// â”€â”€â”€ ReminderRule â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model ReminderRule {
  id                    String   @id @default(cuid())
  name                  String
  description           String?
  anchorMilestoneId     String?
  targetMilestoneCode   String?
  graceDays             Int      @default(3)
  repeatEveryDays       Int      @default(5)
  escalateAfterChases   Int      @default(3)
  requiresExchangeReady Boolean  @default(false)
  useEventDate          Boolean  @default(false)
  // When true, the engine anchors on PropertyTransaction.completionDate
  // instead of the anchor milestone's completedAt. The anchorMilestoneId
  // still gates the reminder's existence (e.g. VM20 only activates after
  // VM19 is complete), but the actual due date is measured from the
  // agreed completion date stored at exchange. Used by VM20 / PM27.
  useCompletionDate     Boolean  @default(false)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  anchorMilestone MilestoneDefinition? @relation("AnchorMilestone", fields: [anchorMilestoneId], references: [id])
  reminderLogs    ReminderLog[]
}

model ReminderLog {
  id             String            @id @default(cuid())
  transactionId  String
  reminderRuleId String
  status         ReminderLogStatus @default(active)
  nextDueDate    DateTime
  sourceDateUsed DateTime?
  statusReason   String?
  snoozedUntil   DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Phase 0 shadow attribution. Backfilled for PM-prefixed
  // targetMilestoneCode rules only. Not read anywhere yet.
  buyerRoundId String?
  buyerRound   BuyerRound? @relation(fields: [buyerRoundId], references: [id], onDelete: SetNull)

  transaction  PropertyTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  reminderRule ReminderRule        @relation(fields: [reminderRuleId], references: [id])
  chaseTasks   ChaseTask[]

  @@index([transactionId, reminderRuleId])
  @@index([status, nextDueDate])
  @@index([buyerRoundId])
}

enum ReminderLogStatus {
  active
  completed
  cancelled
  inactive
}

model ChaseTask {
  id               String          @id @default(cuid())
  transactionId    String
  reminderLogId    String
  assignedToId     String?
  dueDate          DateTime
  status           ChaseTaskStatus @default(pending)
  priority         TaskPriority    @default(normal)
  chaseCount       Int             @default(0)
  // Of chaseCount, how many were performed by a HUMAN (the ↻ Chased button,
  // a drawer/outbound chase, or the manual "I chased them" record). The
  // automated client-chase digest bumps chaseCount (the total) but NOT this.
  // Escalation reads manualChaseCount, not chaseCount: automated sends inform
  // the total but must never arm the urgent flag on their own. The auto count
  // shown in the UI is (chaseCount - manualChaseCount). This reverses the
  // earlier "digest counts as an agent chase for escalation" decision — see
  // docs/active/honest-chase-count/scope.md.
  manualChaseCount Int             @default(0)
  // Set on every real chase increment. NULL means "never chased yet".
  // Escalation requires chaseCount >= rule.escalateAfterChases AND
  // (now - lastChasedAt) >= rule.repeatEveryDays — i.e. another full
  // cycle has elapsed since the last actual chase. The engine NEVER
  // ticks chaseCount on calendar arithmetic alone; only real chase
  // actions (button click, manual record, outbound email, client-chase
  // digest enqueue) move it. See docs/active/honest-chase-count.
  lastChasedAt     DateTime?
  notes            String?
  // Discrete-kind marker for tasks the system handed to the agent because
  // automated chasing failed. Null for normal engine-created tasks. First
  // value: "client_opted_out" — set when a client unsubscribed (A2/A3) and
  // a chase that would have emailed them was redirected to the agent. UI
  // renders a yellow chip on the work-queue row when this is set.
  // Free-form String (not a Prisma enum) so future fallback kinds can be
  // added without a schema migration.
  fallbackKind     String?
  // Free-text reason captured on a MANUAL escalation. Null for automatic
  // engine-triggered escalations (which flip on the chaseCount + graceDays
  // rule and have no user-supplied reason). Cleared when the task is
  // chased-through (applyChaseToTask resets priority to normal) or
  // completed. Surfaced by a tooltip on the "Escalated" chip so the file
