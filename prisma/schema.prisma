  vendor
  purchaser
}

model MilestoneCompletion {
  id                    String         @id @default(cuid())
  transactionId         String
  milestoneDefinitionId String
  state                 MilestoneState @default(locked)
  completedAt           DateTime?
  eventDate             DateTime?
  // Client-supplied speculation about WHEN a milestone will happen — set
  // via the chase confirm page's "Set a date" control (Sub-arc B / B5).
  // Distinct from eventDate (which is the REAL date when complete) and
  // from completedAt (when our system marked it complete). Cleared when
  // the milestone is later confirmed (so it doesn't shadow the real date).
  // Allows the chase pipeline to track "client said 15 June" engagement
  // without prematurely marking the milestone complete.
  expectedDate          DateTime?
  notRequiredReason     String?
  // NR-specific attribution. Distinct from completedById/completedAt which
  // track the last actor to flip TO the "complete" state. When a milestone
  // moves to "not_required", these capture who did it + when — so the
  // timeline can render "Marked not required by Sam · 3 Jul" without
  // conflating NR with a real completion. Cleared on undo.
  notRequiredById       String?
  notRequiredAt         DateTime?
  completedById         String?
  confirmedByPortal     Boolean        @default(false)
  summaryText           String?
  reconciledAtExchange  Boolean        @default(false)
  reconciledAtClaim     Boolean        @default(false)
  outOfOrderCompletion  Boolean        @default(false)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  // Phase 1 of the relist feature — purchaser rows are now scoped per
  // BuyerRound. Vendor (file-level) rows keep buyerRoundId NULL.
  // Uniqueness is enforced by two partial indexes in
  // 20260604000000_buyer_round_milestone_uniqueness/migration.sql
  // (Prisma cannot express partial uniques in schema). The compound
  // (transactionId, milestoneDefinitionId) is kept as a regular index
  // for read performance — many callsites still filter by it.
  buyerRoundId String?
  buyerRound   BuyerRound? @relation(fields: [buyerRoundId], references: [id], onDelete: SetNull)

  transaction         PropertyTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  milestoneDefinition MilestoneDefinition @relation(fields: [milestoneDefinitionId], references: [id])
  completedBy         User?               @relation("CompletedBy", fields: [completedById], references: [id])
  notRequiredBy       User?               @relation("NotRequiredBy", fields: [notRequiredById], references: [id])

  @@index([transactionId, milestoneDefinitionId])
  @@index([transactionId, completedAt])
  @@index([buyerRoundId])
}

// â”€â”€â”€ ReminderRule â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model ReminderRule {
  id                    String   @id @default(cuid())
  name                  String
  description           String?
  anchorMilestoneId     String?
  targetMilestoneCode   String?
  graceDays             Int      @default(3)
  repeatEveryDays       Int      @default(5)
  escalateAfterChases   Int      @default(3)
  requiresExchangeReady Boolean  @default(false)
  useEventDate          Boolean  @default(false)
  // When true, the engine anchors on PropertyTransaction.completionDate
  // instead of the anchor milestone's completedAt. The anchorMilestoneId
  // still gates the reminder's existence (e.g. VM20 only activates after
  // VM19 is complete), but the actual due date is measured from the
  // agreed completion date stored at exchange. Used by VM20 / PM27.
  useCompletionDate     Boolean  @default(false)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
