// â”€â”€â”€ NextAuth â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// NOTE: Account and Session are part of NextAuth's standard adapter scaffolding.
// Account rows are written when a user signs in via OAuth (Google, Azure AD).
// Session table is unused â€” we use JWT session strategy.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  ext_expires_in    Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A user's connected Microsoft Outlook mailbox (Microsoft Graph, delegated).
// Distinct from the NextAuth `Account` table (which is login-only, plaintext,
// managed by the adapter): this is a first-class integration with mail scopes,
// and its access + refresh tokens are ENCRYPTED at rest via
// lib/security/token-crypto.ts (AES-256-GCM). A user may connect SEVERAL
// mailboxes (e.g. one per agency domain), one row each, keyed by the Microsoft
// account id. Phase 1 = connection only; later phases add token refresh + reads.
model OutlookConnection {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identity of the connected Microsoft account, from Graph /me.
  microsoftUserId String // Graph "id" (immutable object id)
  email           String // userPrincipalName / mail — shown in the UI
  displayName     String?

  // Encrypted credentials. Never logged, never sent to the client.
  accessToken     String // encrypted (iv:tag:ciphertext hex)
  refreshToken    String // encrypted
  tokenExpiresAt  DateTime // when the access token expires (for later refresh)
  scope           String // granted scopes, space-delimited

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // One row per (user, mailbox): reconnecting the same mailbox updates it,
  // a different mailbox adds a new row.
  @@unique([userId, microsoftUserId])
  @@index([microsoftUserId])
}

// ── WhatsApp integration ─────────────────────────────────────────────────────
// Unofficial linked-device (Baileys) bridge, passive listener only. Full design
// in docs/WHATSAPP_INTEGRATION.md. The bridge runs off-platform (Railway) and
// POSTs normalised messages into /api/integrations/whatsapp/ingest.

// One row per connected WhatsApp number. Mirrors OutlookConnection, but the
// Baileys session credentials live on the bridge host, NOT here — this row is
// pairing/status only, so nothing sensitive is stored in the app DB.
model WhatsAppConnection {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber   String // E.164 of the linked account, once known
  displayName   String?
  status        String    @default("pending_qr") // pending_qr | connected | disconnected
  lastSeenAt    DateTime? // last time the bridge reported the socket alive
  lastMessageAt DateTime? // last message ingested through this connection
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, phoneNumber])
}

// Permanent WhatsApp group/chat -> transaction mapping. Once set, the group can
// be renamed freely; waChatId is the source of truth. matchMethod records how
// the link was first made (auto from the group name, or manual assignment).
model WhatsAppGroupMapping {
  id               String              @id @default(cuid())
  waChatId         String              @unique // permanent WhatsApp group/chat id
  transactionId    String
  transaction      PropertyTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  side             WhatsAppSide
  groupNameAtMatch String?
  matchMethod      String              @default("name_auto") // name_auto | manual
  createdAt        DateTime            @default(now())

  @@index([transactionId])
}

// Holding area for WhatsApp messages we could not confidently route (unmatched
// group, or an ambiguous direct message that could belong to several files).
// Kept OUT of OutboundMessage so null-transaction rows never pollute the comms
// timeline or the admin outbound log. On manual assignment we create the
// OutboundMessage, persist a WhatsAppGroupMapping (for groups), then delete the
// pending row. waMessageId is unique so replays never double-insert.
model WhatsAppPendingMessage {
  id                      String   @id @default(cuid())
  waMessageId             String   @unique // WhatsApp message id (idempotency key)
  waChatId                String
  isGroup                 Boolean
  groupName               String?
  senderPhone             String?
  senderName              String?
  fromMe                  Boolean  @default(false)
  body                    String?
  mediaMeta               Json? // { type, mimetype?, caption?, filename? } when a media message
  mediaUrl                String? // stored media object path once the bridge uploads it
  timestamp               DateTime // original WhatsApp message time
  candidateTransactionIds String[] // possible files for an ambiguous DM
  reason                  String // no_match | ambiguous
  createdAt               DateTime @default(now())

  @@index([waChatId])
  @@index([createdAt])
}

enum WhatsAppSide {
  BUYER
  SELLER
}

// A saved, scenario-scoped override of a milestone email's copy. The code
// default in lib/portal-copy.ts is the baseline; a row here replaces it for a
// given (step code, recipient side) and scenario. `tenure` and `purchaseType`
// are "any" to apply broadly, or a specific value to diverge only for that
// scenario. At send time the most-specific matching row wins (exact scenario >
// one axis specific > any/any > code default). Edited from Command Centre.
model MilestoneEmailOverride {
  id           String  @id @default(cuid())
  code         String // milestone code, e.g. "PM9"
  side         String // "vendor" | "purchaser" | "vendorAgent" | "progressor"
  tenure       String  @default("any") // "any" | "freehold" | "leasehold"
  purchaseType String  @default("any") // "any" | "mortgage" | "cash"

  // The six editable fields of a RecipientEmailCopy.
  subject      String
  heroLabel    String
  opening      String
  whatHappened String
  whatNext     String?
  action       String?

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([code, side, tenure, purchaseType])
  @@index([code, side])
}

// Client-portal "Updates" copy overrides, edited from the Command Centre. One
// row per milestone code. Separate from the agent-side wording (lib/updates-copy
// CORES) and from the email overrides above. Any field null = fall back to the
// hardcoded default. Applies to the next portal render immediately.
model MilestoneUpdateOverride {
  id           String   @id @default(cuid())
  code         String   @unique // milestone code, e.g. "PM8"
  core         String? // confirmation clause, e.g. "solicitor has ordered the searches"
  subtextOwn   String? // subtext when it's the viewer's own step
  subtextOther String? // subtext when it's the other party's step
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

