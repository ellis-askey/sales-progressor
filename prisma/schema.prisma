model Contact {
  id                    String      @id @default(cuid())
  propertyTransactionId String
  name                  String
  phone                 String?
  email                 String?
  roleType              ContactRole
  portalToken           String?     @unique
  lastVisitedPortalAt   DateTime?
  // First-visit welcome sheet gate. Stamped once when the client dismisses the
  // welcome drawer ("Got it"). Makes the sheet show once per PERSON, forever,
  // across every device — localStorage alone was per-browser, so it re-appeared
  // on each new device or after clearing storage. Set via
  // /api/portal/[token]/welcome-seen; read by getPortalData -> PortalShell.
  welcomeSeenAt         DateTime?
  // Exchange-day: stamped when the client confirms via their portal that they've
  // given their solicitor authority to exchange. Counts for the CURRENT exchange
  // day only (valid when >= the file's exchangeDayStartedAt), so a re-activated
  // day re-asks. See docs/active/exchange-day-SPEC.md.
  exchangeAuthorityGivenAt DateTime?
  // PWA adoption signal (Command Centre → App adoption). pwaInstalledAt: first
  // time we saw them in standalone display-mode or caught the appinstalled
  // event — the truest "added it to their home screen". pwaLastOpenedAt: most
  // recent standalone open. iOS gives no install event, so a standalone open
  // is the only reliable signal there.
  pwaInstalledAt        DateTime?
  pwaLastOpenedAt       DateTime?
  // Set when the contact clicks the unsubscribe link in any platform email
  // addressed to them. Mirrors User.emailUnsubscribedAt. Suppression check
  // via isContactEmailSuppressed in lib/email.ts. Foundation for the
  // client-chase arc (A2/A3 of Sub-arc A in
  // docs/active/client-chase-discovery.md). No callers yet.
  unsubscribedAt        DateTime?
  // Agent-side per-contact chase-email pause (2026-08-11 email-settings
  // drawer). Null = chase emails send; set = paused by an agent. Replaces
  // the per-SIDE PropertyTransaction.vendorEmailsPaused /
  // purchaserEmailsPaused reads in the client-chase cron (those columns
  // remain in place, backfilled into this one at migration time).
  // Distinct from unsubscribedAt: that is the CLIENT opting out of
  // everything; this is the AGENT pausing chasing for one person.
  emailsPausedAt        DateTime?
  // Client-set timed pause on CHASE emails only (audit #11 / #15). Set to a
  // future date when a client hits "pause for a week" in a chase email or
  // picks a pause length in the portal menu. The chase cron skips them while
  // this is in the future; it auto-resumes once it passes. Distinct from
  // emailsPausedAt (agent-set, indefinite) and unsubscribedAt (client opted
  // out of everything). Milestone / chain / exchange emails ignore this.
  chasesPausedUntil     DateTime?
  // White-labelled "Getting your sale moving" intro email — fired once per
  // contact, on outsourced sale creation. Atomic check-and-stamp (updateMany
  // where outsourceIntroSentAt IS NULL) guarantees one send per contact per
  // sale even under concurrent callers. See lib/emails/send-outsource-intro.ts
  // for the orchestrator.
  outsourceIntroSentAt  DateTime?
  // Client-uploaded profile photo (audit #16, phase 2). Full public Supabase
  // Storage URL, same shape as User.image. Null = no photo; render sites fall
  // back to the contact's initials, then the generic client silhouette. The
  // client sets this themselves from the portal menu.
  image                 String?
  // Client-chosen overview layout (portal "Customize overview", 2026-08-17).
  // Shape: { order: string[]; hidden: string[] } of moveable card keys. Fixed
  // cards ignore it. Null = default order, nothing hidden.
  overviewLayout        Json?
  // Stamped when this buyer requests a mortgage-broker call-back from the
  // portal card (2026-08-21). Drives the card's "requested" acknowledgment
  // state; the card gates on ANY purchaser on the file having this set, so a
  // joint co-buyer can't double-request. Null = not requested.
  brokerCallbackRequestedAt DateTime?
  // Client-chosen portal appearance + accessibility settings (Batch 4,
  // 2026-08-17). Shape: { theme, textSize, accent, reduceMotion, highContrast,
  // dyslexicFont, whatsappOptIn }. Null = all defaults. "Hide money" is
  // per-device (localStorage), deliberately NOT stored here.
  portalSettings        Json?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Phase 0 shadow attribution. Not read anywhere yet.
  buyerRoundId String?
  buyerRound   BuyerRound? @relation(fields: [buyerRoundId], references: [id], onDelete: SetNull)

  transaction       PropertyTransaction      @relation(fields: [propertyTransactionId], references: [id], onDelete: Cascade)
  pushSubscriptions PortalPushSubscription[]
  portalMessages    PortalMessage[]
  documents         TransactionDocument[]
  outboundEmails    OutboundEmailQueue[]     @relation("OutboundEmailQueueRecipientContact")
  clientChaseStates ClientChaseState[]
  quoteRequests     QuoteRequest[]
  portalVisits      PortalVisit[]
  portalTimeSessions PortalTimeSession[]

  @@index([buyerRoundId])
}

// One row per contact per day they open their portal (audit #6). Lets the
// risk engine tell a client who was checking in regularly and then went quiet
// (a strong early sign of a wobble) apart from one who never engaged. Deduped
// to one row per contact per UK day via the unique index, so volume stays low.
model PortalVisit {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  day       String   // YYYY-MM-DD, UK local day of the visit
  createdAt DateTime @default(now())

  @@unique([contactId, day])
  @@index([contactId])
}

model PortalPushSubscription {
  id        String   @id @default(cuid())
  contactId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model PortalMessage {
  id            String   @id @default(cuid())
  transactionId String
  contactId     String
  content       String
  fromClient    Boolean  @default(true)
  sentById      String?
  createdAt     DateTime @default(now())

  // Phase 0 shadow attribution. Not read anywhere yet.
  buyerRoundId String?
  buyerRound   BuyerRound? @relation(fields: [buyerRoundId], references: [id], onDelete: SetNull)

  transaction PropertyTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  contact     Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sentBy      User?               @relation("PortalMessagesSentBy", fields: [sentById], references: [id])

  @@index([transactionId, contactId, createdAt])
  @@index([buyerRoundId])
}

