// â”€â”€â”€ Command Centre: Content drafter â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// DraftPost â€” every generation session. Variant1/2 are the raw Claude outputs.
// editedText is the user's final version; chosenVariant records which was kept.
// VoiceSample â€” founder voice corpus used in generation prompts.

enum DraftChannel {
  linkedin
  twitter
  tiktok_script
  instagram_caption
  instagram_reel_script
}

model DraftPost {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  channel    DraftChannel
  tone       String?
  topicSeed  String
  sourceType String // "manual" | "activity-derived"

  prompt          String
  aiModel         String
  aiPromptVersion String

  variant1      String
  variant2      String
  editedText    String?
  chosenVariant Int? // 1 or 2 â€” which variant the user started from

  posted            Boolean   @default(false)
  postedAt          DateTime?
  regenerationCount Int       @default(0)

  aiTokensInput  Int?
  aiTokensOutput Int?

  topicId String? // ContentTopic this draft was generated from
  batchId String? // ContentBatch.id â€” set when batch email is sent

  approvedForBatch Boolean @default(false) // user flagged this variant for the morning batch
  postedUrl        String? // URL of the live post (filled when marking as posted)

  @@index([createdAt])
  @@index([channel, createdAt])
  @@index([posted])
  @@index([topicId])
  @@index([approvedForBatch])
}

