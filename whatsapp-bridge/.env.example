# WhatsApp bridge config. Copy to .env for local runs; set as service variables on Railway.

# Where to POST normalised messages. The PWA ingest endpoint.
#   staging: https://salesprogressor-git-staging-...vercel.app/api/integrations/whatsapp/ingest
#   prod:    https://portal.thesalesprogressor.co.uk/api/integrations/whatsapp/ingest
PWA_INGEST_URL=""

# Shared bearer secret — MUST equal WHATSAPP_BRIDGE_SECRET set on the PWA (Vercel)
# for the same environment. Generate: openssl rand -hex 32.
WHATSAPP_BRIDGE_SECRET=""

# Secret that guards the bridge's own /status and /qr HTTP endpoints (the PWA
# reads the QR from here during pairing). Can reuse WHATSAPP_BRIDGE_SECRET or set
# its own value; if unset it falls back to WHATSAPP_BRIDGE_SECRET.
BRIDGE_CONTROL_SECRET=""

# Local paths. On Railway, point AUTH_DIR + QUEUE_DIR at a mounted volume so the
# session survives restarts (no re-scan) and queued messages are not lost.
AUTH_DIR="./auth"
QUEUE_DIR="./queue"

# HTTP port for /health, /status, /qr (Railway sets PORT automatically).
PORT="8080"
